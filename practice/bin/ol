#!/usr/bin/env bash
# ol - the openlearn practice harness.
#
# The learning path is the track directories: you read them, in the order a
# role path under content/courses/build-an-llm/paths/ gives (ol learn). The practice path is everything
# else here: you do them. Every exercise works the same way, whatever its kind
# or language.
#
#   ol learn                       list paths and your progress on each
#   ol learn  <path>               its stages, what "done" means, which you finished
#   ol learn  <path> <stage|next>  read a stage (n, or part:n for an included part)
#   ol learn  <path> --done <stage>  mark it finished (--undo <stage> reverses it)
#   ol learn  --verify             maintainer check: includes resolve, files exist
#
#   ol start  <kind> <lang> <id>   clone the exercise into .scratchpad/ and open it
#   ol check  <kind> <lang> [id]   run your attempt; exit code is the verdict
#   ol diff   <kind> <lang> <id>   your attempt against the reference
#   ol list   [kind] [lang]        what exists, and what you have attempted
#   ol show   <kind> <lang> <id>   print the reference source (spoils it)
#   ol score  [kind] [lang]        tally
#   ol reveal <kind> <lang> <id>   just run the reference (burns the exercise)
#   ol reset  <kind> <lang> <id>   throw your attempt away and start cold
#   ol where                       print the paths this script is using
#   ol verify [kind] [lang]        maintainer check: every reference builds,
#                                  passes, and is deterministic. Prints no
#                                  exercise output, so it spoils nothing.
#   ol bench  [lang] [--assert]    wall time and peak memory per predict snippet,
#                                  against the ceilings in predict/budgets.tsv
#
# Course modules (course/DESIGN.md section 5), addressed by id (M03.1, L8.3,
# rt.01, lang.02, S-M07a, ...); the heavy lifting is python -m olcourse in the
# uv project course/harness:
#
#   ol course init --name <system> [--at DIR]   create your course repo
#   ol start  <ID>                 stub the module's units into your repo
#   ol check  <ID> [--ref-deps[=all|ID,..]] [--no-cumulative] [--kind K] [--json]
#   ol check  --all [--ci]         every started module, in pass order
#   ol tests  <ID>                 the annotated test catalog
#   ol diff | show | reveal | reset <ID>
#   ol status [--graph|--counts|--json]   ol next
#   ol contracts sync [--to REV]   ol lint [--links] [--fix-index]
#   ol milestone <MS-ID> [--smoke] [--ref-deps]   run a milestone through YOUR entry points
#   ol conform openapi[:v0|v1|v2][:engine|gateway] [--base URL]   OpenAPI conformance
#   ol mutate <ID> [-j N] [--reveal-survivors]   the mutation grade of YOUR tests
#   ol tdd red|green <ID>          red then green (rung R3 and up)
#   ol parity [<suite>..] [--fuzz] [--ref]   every implementation vs one oracle
#   ol fetch <asset>.. | --list    pinned large assets (ASSETS.tsv, sha256)
#   ol drill list|start <name>|status|end|reset|run <name> --respond   faults (gated)
#   ol export <DIR> [--remote URL] [--allow-incomplete]   your standalone repo
#   ol doctor [--pass N]           ol course ci   (prints the learner CI recipe)
#   ol verify course [ID..] [--changed REF] [--global] [--e2e] [--kind]
#   ol bench  <ID>|course|--calibrate      (course perf; `ol bench [lang]` stays predict)
#
# Kinds:
#   predict     you write the exact output you expect, then diff against reality
#   build       you implement from scratch against a self-testing reference
#   reattempt   an already-solved problem from content/tracks/algorithms/ or content/case-studies/,
#               handed back to you with the solution stripped out
#
# Your work lives in .scratchpad/ at the repo root and is gitignored. Nothing
# you write while practising is ever committed, and neither is learn progress.

set -uo pipefail
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRACTICE="$(cd "$BIN_DIR/.." && pwd)"
ROOT="$(cd "$PRACTICE/.." && pwd)"
SCRATCH="${OL_SCRATCH:-$ROOT/.scratchpad}"

# Pick up any per-project toolchains pinned in .mise.toml.
#
# This is not optional convenience. mise's shell hook only installs itself in
# INTERACTIVE shells, and this script is not one, so without this a toolchain
# that works when you type `javac` by hand is missing when `ol` runs it. On
# macOS that failure is especially quiet: /usr/bin/javac exists and is
# executable, so nothing reports "not found" and you instead get "Unable to
# locate a Java Runtime" from a stub.
#
# Resolved relative to the repo root rather than the caller's directory, so it
# holds no matter where ol is invoked from. A no-op when mise is not installed.
if command -v mise >/dev/null 2>&1 && [[ -f "$ROOT/.mise.toml" ]]; then
  eval "$(cd "$ROOT" && mise env -s bash 2>/dev/null)" || true
fi

RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; DIM=$'\033[2m'; BLD=$'\033[1m'; RST=$'\033[0m'
[[ -t 1 ]] || { RED=; GRN=; YEL=; DIM=; BLD=; RST=; }

die() { echo "${RED}error:${RST} $*" >&2; exit 1; }
rel() { echo "${1#$ROOT/}"; }

KINDS="predict build reattempt"

# ---------------------------------------------------------------------------
# Languages
#
# predict has four, build has nine, reattempt is organised by source track
# instead of by language. Aliases exist because the build tree spells out
# "typescript" while the predict tree uses "ts", and typing either should work.
# ---------------------------------------------------------------------------

langs_predict()   { echo "go rust python ts"; }
langs_reattempt() { echo "algorithms case-studies"; }

# Build languages are split by whether they are actually used here.
#
# Core is what the curriculum targets and what CI verifies. Optional languages
# are still fully supported by every command, and `ol <verb> build <lang>` works
# on them, but they are left out of the no-argument fan-out so that a missing
# toolchain is never a failure in a run you did not ask for.
langs_build_core()     { echo "go rust python typescript c cpp"; }
langs_build_optional() { echo "zig scala java"; }
langs_build()          { echo "$(langs_build_core) $(langs_build_optional)"; }

langs_for() {
  case "$1" in
    predict)   langs_predict ;;
    build)     langs_build_core ;;   # fan-out default; see langs_build above
    reattempt) langs_reattempt ;;
  esac
}

# Every language, for validation and for `ol where`.
langs_all_for() {
  case "$1" in
    build) langs_build ;;
    *)     langs_for "$1" ;;
  esac
}

is_optional_lang() {
  case " $(langs_build_optional) " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# The command that proves a language's toolchain is actually usable.
#
# Note java: `command -v javac` is not enough, because macOS ships
# /usr/bin/javac as a stub that exists, is executable, and only prints
# "Unable to locate a Java Runtime". The probe has to RUN it.
toolchain_probe() {
  case "$1" in
    c)          cc --version ;;
    cpp)        c++ --version ;;
    rust)       rustc --version ;;
    go)         go version ;;
    python)     uv --version ;;
    typescript) node --version ;;
    zig)        zig version ;;
    scala)      scala-cli version ;;
    java)       javac -version ;;
    *)          return 0 ;;
  esac >/dev/null 2>&1
}

# Canonical spelling for a language within a kind.
norm_lang() {
  local kind="$1" l="$2"
  case "$kind:$l" in
    predict:typescript) l=ts ;;
    predict:ts)         l=ts ;;
    build:ts)           l=typescript ;;
    build:c++|build:cxx) l=cpp ;;
    build:py)           l=python ;;
    predict:py)         l=python ;;
    reattempt:algo|reattempt:algorithms) l=algorithms ;;
    reattempt:cs|reattempt:case-studies) l=case-studies ;;
  esac
  echo "$l"
}

valid_kind() {
  case " $KINDS " in *" $1 "*) ;; *) die "unknown kind '$1' (want: $KINDS)" ;; esac
}

valid_lang() {
  local kind="$1" l="$2"
  case " $(langs_all_for "$kind") " in
    *" $l "*) ;;
    *) die "unknown $kind language '$l' (want: $(langs_all_for "$kind"))" ;;
  esac
}

# Tier directory for a build language, since the build tree groups by tier.
build_tier() {
  case "$1" in
    c|cpp|rust|zig)   echo systems ;;
    go|scala|java)    echo cloud ;;
    python|typescript) echo general ;;
  esac
}

# ---------------------------------------------------------------------------
# Locating exercises
#
# ex_dir  -> the committed reference directory (or file, for predict)
# ex_name -> the NN-name identity used everywhere in output and paths
# ---------------------------------------------------------------------------

lang_root() {
  local kind="$1" lang="$2"
  case "$kind" in
    predict)   echo "$PRACTICE/predict/$lang" ;;
    build)     echo "$PRACTICE/build/$(build_tier "$lang")/$lang" ;;
    reattempt) echo "$PRACTICE/reattempt" ;;
  esac
}

# All exercise names (NN-name) for a kind+lang, sorted.
all_names() {
  local kind="$1" lang="$2" lr; lr="$(lang_root "$kind" "$lang")"
  case "$kind" in
    predict)
      case "$lang" in
        go)     find "$lr/predict" -maxdepth 1 -type d -name '[0-9][0-9]-*' -exec basename {} \; 2>/dev/null ;;
        rust)   find "$lr/predict/src/bin" -maxdepth 1 -name '[0-9][0-9]-*.rs' -exec basename {} .rs \; 2>/dev/null ;;
        python) find "$lr/predict" -maxdepth 1 -name '[0-9][0-9]-*.py' -exec basename {} .py \; 2>/dev/null ;;
        ts)     find "$lr/predict" -maxdepth 1 -name '[0-9][0-9]-*.ts' -exec basename {} .ts \; 2>/dev/null ;;
      esac ;;
    build)
      find "$lr" -maxdepth 1 -type d -name '[0-9][0-9]-*' -exec basename {} \; 2>/dev/null ;;
    reattempt)
      manifest_names "$lang" ;;
  esac | sort
}

# Resolve an id prefix ("03") or a full name to the full exercise name.
resolve_name() {
  local kind="$1" lang="$2" id="$3" hit
  hit="$(all_names "$kind" "$lang" | awk -v id="$id" '$0 == id || index($0, id "-") == 1' | head -1)"
  [[ -n "$hit" ]] || return 1
  echo "$hit"
}

# ---------------------------------------------------------------------------
# reattempt manifest
#
# content/tracks/algorithms/ and content/case-studies/ already hold solved, committed code. Rather
# than copy any of it into practice/, the manifest points at it in place and
# ol strips the solution on the way into the scratchpad.
#
# Columns: track <TAB> name <TAB> source path (repo-relative)
# ---------------------------------------------------------------------------

MANIFEST="$PRACTICE/reattempt/manifest.tsv"

manifest_rows() {
  [[ -f "$MANIFEST" ]] || return 0
  awk -F'\t' -v track="$1" '
    /^[[:space:]]*(#|$)/ { next }
    $1 == track { print $2 "\t" $3 }
  ' "$MANIFEST"
}

manifest_names() { manifest_rows "$1" | cut -f1; }

manifest_source() {
  local track="$1" name="$2" p
  p="$(manifest_rows "$track" | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')"
  [[ -n "$p" ]] || return 1
  echo "$ROOT/$p"
}

# ---------------------------------------------------------------------------
# Reference sources
#
# For build and reattempt, the reference is the committed solution. For
# predict, the "reference" is the snippet itself, which you never edit.
# ---------------------------------------------------------------------------

ref_path() {
  local kind="$1" lang="$2" name="$3" lr; lr="$(lang_root "$kind" "$lang")"
  case "$kind" in
    predict)
      case "$lang" in
        go)     echo "$lr/predict/$name/main.go" ;;
        rust)   echo "$lr/predict/src/bin/$name.rs" ;;
        python) echo "$lr/predict/$name.py" ;;
        ts)     echo "$lr/predict/$name.ts" ;;
      esac ;;
    build)     echo "$lr/$name" ;;
    reattempt) manifest_source "$lang" "$name" ;;
  esac
}

# ---------------------------------------------------------------------------
# Your workspace in .scratchpad/
# ---------------------------------------------------------------------------

work_dir() { echo "$SCRATCH/$1/$2/$3"; }

# predict keeps a single prediction file rather than a workspace.
pred_file() { echo "$SCRATCH/predict/$1/$2.txt"; }

# Has this exercise been attempted?
attempted() {
  local kind="$1" lang="$2" name="$3"
  if [[ "$kind" == predict ]]; then
    [[ -s "$(pred_file "$lang" "$name")" ]]
  else
    [[ -d "$(work_dir "$kind" "$lang" "$name")" ]]
  fi
}

# ---------------------------------------------------------------------------
# Stub generation
#
# A reference marks the parts you are supposed to write with begin/end markers
# on their own lines, in whatever comment syntax the language uses. Cloning
# replaces each marked region with a single TODO. That means one committed
# source of truth per exercise, instead of a reference and a stub that drift
# apart.
#
# A file with no markers is copied verbatim: that is how tests, headers and
# scaffolding come along untouched.
#
# Two details that are easy to get wrong and produce broken stubs:
#
#   * The TODO is built by substituting into the marker line itself rather than
#     by keeping only the text before the marker. Otherwise a C-style
#     "/* MARKER */" yields "/* TODO..." with no closing "*/", an unterminated
#     comment that silently swallows the next function.
#   * A marker only counts when its line holds nothing but comment punctuation
#     and the marker. Prose that mentions the marker by name, in a header
#     comment or a README, is not a marker.
# ---------------------------------------------------------------------------

MARKER_BEGIN='SOLUTION-BEGIN'
MARKER_END='SOLUTION-END'
# Leading comment punctuation, the marker with an optional module id
# ("SOLUTION-BEGIN L9.1"), then optional closers like "*/".
MARKER_RE="^[^A-Za-z0-9]*(${MARKER_BEGIN}( [A-Za-z][A-Za-z0-9.+-]*)?|${MARKER_END})[^A-Za-z0-9]*$"

# strip_solution <file> [want]: a region is stubbed when its id is empty or
# equals want; a region carrying another id keeps its body and loses only its
# marker lines. Practice exercises carry no ids, so they behave as before.
# (Course files get compiling stubs from the course harness instead.)
strip_solution() {
  awk -v b="$MARKER_BEGIN" -v e="$MARKER_END" -v want="${2:-}" '
    function is_begin(line) { return line ~ ("^[^A-Za-z0-9]*" b "( [A-Za-z][A-Za-z0-9.+-]*)?[^A-Za-z0-9]*$") }
    function is_end(line)   { return line ~ ("^[^A-Za-z0-9]*" e "[^A-Za-z0-9]*$") }
    function marker_id(line,   s) {
      s = line
      sub("^[^A-Za-z0-9]*" b, "", s)
      sub(/^ /, "", s)
      sub(/[^A-Za-z0-9.+-].*$/, "", s)
      return s
    }
    is_begin($0) {
      id = marker_id($0)
      if (id == "" || id == want) {
        todo = $0
        sub(b "( [A-Za-z][A-Za-z0-9.+-]*)?", "TODO: your implementation goes here.", todo)
        print todo
        skip = 1
      }
      next
    }
    is_end($0) { skip = 0; next }
    !skip { print }
  ' "$1"
}

has_markers() { grep -Eq "$MARKER_RE" "$1" 2>/dev/null; }

# The reference with its marker lines removed: what you would have written if
# you had got it right. This is the side `ol diff` compares against, because
# diffing against the markers themselves is just noise.
drop_markers() { grep -Ev "$MARKER_RE" "$1"; }

# ---------------------------------------------------------------------------
# Running things
#
# Every build exercise is self-testing: it has one entry point that asserts and
# exits nonzero when an assertion fails, which is the same contract the
# case-studies use. So "check" is just "run it, and look at $?" in every
# language, and no test framework is involved anywhere.
#
# An exercise that needs something this table cannot express (an external
# crate, a code generator, a linker invocation) ships an executable run.sh and
# that wins.
# ---------------------------------------------------------------------------

# Run inside directory $1, for build language $2. Output and exit code pass through.
#
# Compiled output goes to a scratchpad directory keyed by the exercise path,
# never next to the source. Building in place would drop binaries and class
# files into the repository every time CI verified a reference, and the first
# person to run `git add -A` would commit them.
run_build_dir() {
  local d="$1" lang="$2" out
  if [[ -x "$d/run.sh" ]]; then (cd "$d" && ./run.sh); return $?; fi

  out="$SCRATCH/.build/$(printf '%s' "${d#$ROOT/}" | tr '/' '_')"
  mkdir -p "$out" || return 1

  case "$lang" in
    c)     (cd "$d" && cc -std=c11 -Wall -Wextra -Wno-unused-parameter -o "$out/bin" ./*.c 2>&1 && "$out/bin") ;;
    cpp)   (cd "$d" && c++ -std=c++20 -Wall -Wextra -o "$out/bin" ./*.cpp 2>&1 && "$out/bin") ;;
    rust)  (cd "$d" && rustc --edition 2021 -A dead_code -o "$out/bin" main.rs 2>&1 && "$out/bin") ;;
    zig)   (cd "$d" && zig run main.zig --cache-dir "$out" 2>&1) ;;
    go)    (cd "$d" && GOCACHE="${GOCACHE:-$out/gocache}" go run . 2>&1) ;;
    scala) (cd "$d" && scala-cli run . 2>&1) ;;
    java)  (cd "$d" && javac -d "$out" ./*.java 2>&1 && java -cp "$out" Main) ;;
    python)     (cd "$d" && uv run --no-project --quiet python main.py 2>&1) ;;
    typescript) (cd "$d" && node main.ts 2>&1) ;;
  esac
}

# Run a reattempt source file, by extension. As above, anything compiled lands
# in the scratchpad rather than beside the source, which here would mean
# dropping binaries into content/tracks/algorithms/ and content/case-studies/.
run_reattempt_file() {
  local f="$1" d out; d="$(dirname "$f")"
  out="$SCRATCH/.build/$(printf '%s' "${f#$ROOT/}" | tr '/' '_')"
  case "$f" in
    *.py) (cd "$d" && uv run --no-project --quiet python "$(basename "$f")" 2>&1) ;;
    *.js) (cd "$d" && node "$(basename "$f")" 2>&1) ;;
    *.ts) (cd "$d" && node "$(basename "$f")" 2>&1) ;;
    *.c)  mkdir -p "$out" && (cd "$d" && cc -std=c11 -o "$out/bin" "$(basename "$f")" 2>&1 && "$out/bin") ;;
    *)    echo "no runner for $(basename "$f")" >&2; return 1 ;;
  esac
}

# Run a predict snippet from the committed tree, merging stderr in.
run_snippet() {
  local lang="$1" name="$2" lr; lr="$(lang_root predict "$lang")"
  case "$lang" in
    go)     (cd "$PRACTICE/predict/go"           && go run "./predict/$name" 2>&1) ;;
    rust)   (cd "$PRACTICE/predict/rust/predict" && cargo run --quiet --bin "$name" 2>&1) ;;
    python) (cd "$PRACTICE/predict/python"       && uv run --no-project --quiet python "predict/$name.py" 2>&1) ;;
    ts)     (cd "$PRACTICE/predict/ts"           && node "predict/$name.ts" 2>&1) ;;
  esac
}

# Compile ahead of time, so a fresh checkout's first run does not mix compiler
# output into a snippet's stdout and show up as a false diff.
prepare_predict() {
  case "$1" in
    go)   (cd "$PRACTICE/predict/go"           && go build ./... >/dev/null) ;;
    rust) (cd "$PRACTICE/predict/rust/predict" && cargo build --quiet --bins) ;;
    *)    : ;;
  esac
}

# Strip trailing whitespace and leading/trailing blank lines, so a correct
# prediction is not called wrong over an extra newline.
normalize() { sed 's/[[:space:]]*$//' | awk 'NF{blank=0; for(i=0;i<held;i++) print ""; held=0; print; seen=1; next} seen{held++}' ; }

# ---------------------------------------------------------------------------
# start
# ---------------------------------------------------------------------------

cmd_start() {
  local kind="$1" lang="$2" id="$3"
  valid_kind "$kind"; lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  local name; name="$(resolve_name "$kind" "$lang" "$id")" || die "no $kind exercise '$id' in $lang"

  if [[ "$kind" == predict ]]; then
    local pf; pf="$(pred_file "$lang" "$name")"
    mkdir -p "$(dirname "$pf")"
    [[ -f "$pf" ]] || : > "$pf"
    cmd_show predict "$lang" "$id"
    echo
    echo "${YEL}Write the exact output you expect into:${RST} $(rel "$pf")"
    echo "${DIM}Commit to it before you run anything. A prediction edited after the fact is worth nothing.${RST}"
    "${EDITOR:-vi}" "$pf"
    return
  fi

  local src wd; src="$(ref_path "$kind" "$lang" "$name")"; wd="$(work_dir "$kind" "$lang" "$name")"
  if [[ -d "$wd" ]]; then
    echo "${YEL}already started:${RST} $(rel "$wd")"
    echo "${DIM}ol reset $kind $lang $id  throws it away and starts cold${RST}"
  else
    mkdir -p "$wd"
    if [[ -d "$src" ]]; then
      # build: clone the whole exercise directory, stripping marked regions.
      local f target
      while IFS= read -r f; do
        target="$wd/${f#$src/}"
        mkdir -p "$(dirname "$target")"
        if has_markers "$f"; then strip_solution "$f" > "$target"; else cp "$f" "$target"; fi
      done < <(find "$src" -type f ! -name '_ss_*')
    else
      # reattempt: a single committed solution file.
      local base; base="$(basename "$src")"
      if has_markers "$src"; then strip_solution "$src" > "$wd/$base"; else cp "$src" "$wd/$base"; fi
    fi
    # Go needs a module to run a directory; the clone is outside the repo's tree.
    if [[ "$kind" == build && "$lang" == go && ! -f "$wd/go.mod" ]]; then
      printf 'module practice/%s\n\ngo 1.22\n' "$name" > "$wd/go.mod"
    fi
    echo "${GRN}started${RST} $kind/$lang/$name"
    echo "  workspace  $(rel "$wd")"
    echo "  check      ol check $kind $lang $id"
  fi

  local entry
  entry="$(find "$wd" -maxdepth 2 -type f \( -name 'main.*' -o -name 'Main.java' -o -name '*.c' -o -name '*.py' -o -name '*.ts' -o -name '*.js' \) ! -name '*_test.*' | sort | head -1)"
  [[ -n "$entry" ]] && "${EDITOR:-vi}" "$entry"
}

# ---------------------------------------------------------------------------
# check
# ---------------------------------------------------------------------------

# 0 = pass, 1 = fail, 2 = not attempted.
check_one() {
  local kind="$1" lang="$2" name="$3" quiet="${4:-}"

  if ! attempted "$kind" "$lang" "$name"; then
    [[ -n "$quiet" ]] || echo "${DIM}skip${RST} $name  (not started: ol start $kind $lang ${name%%-*})"
    return 2
  fi

  if [[ "$kind" == predict ]]; then
    local pf actual expected; pf="$(pred_file "$lang" "$name")"
    actual="$(run_snippet "$lang" "$name" | normalize)"
    expected="$(normalize < "$pf")"
    if [[ "$actual" == "$expected" ]]; then echo "${GRN}PASS${RST} $name"; return 0; fi
    echo "${RED}MISS${RST} $name"
    if [[ -z "$quiet" ]]; then
      diff -u --label "you predicted" <(printf '%s\n' "$expected") \
              --label "actually printed" <(printf '%s\n' "$actual") | sed 's/^/    /'
      echo "    ${YEL}Record this in practice/predict/LEDGER.md before you move on.${RST}"
    fi
    return 1
  fi

  local wd out rc; wd="$(work_dir "$kind" "$lang" "$name")"
  if [[ "$kind" == build ]]; then out="$(run_build_dir "$wd" "$lang")"; rc=$?
  else
    local f; f="$(find "$wd" -maxdepth 1 -type f ! -name '_ss_*' | head -1)"
    out="$(run_reattempt_file "$f")"; rc=$?
  fi

  if [[ $rc -eq 0 ]]; then
    echo "${GRN}PASS${RST} $name"
  else
    echo "${RED}FAIL${RST} $name"
    [[ -n "$quiet" ]] || { printf '%s\n' "$out" | sed 's/^/    /'; echo "    ${DIM}ol diff $kind $lang ${name%%-*}  compares your attempt to the reference${RST}"; }
  fi
  return $rc
}

cmd_check() {
  local kind="$1" lang="$2"
  valid_kind "$kind"; lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  if [[ $# -ge 3 ]]; then
    local name; name="$(resolve_name "$kind" "$lang" "$3")" || die "no $kind exercise '$3' in $lang"
    check_one "$kind" "$lang" "$name"; return $?
  fi
  local n rc=0
  while IFS= read -r n; do
    check_one "$kind" "$lang" "$n" quiet; [[ $? -eq 1 ]] && rc=1
  done < <(all_names "$kind" "$lang")
  return $rc
}

# ---------------------------------------------------------------------------
# diff, show, reveal, reset
# ---------------------------------------------------------------------------

cmd_diff() {
  local kind="$1" lang="$2" id="$3"
  valid_kind "$kind"; lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  [[ "$kind" != predict ]] || die "predict has no reference to diff; use ol check predict $lang $id"
  local name; name="$(resolve_name "$kind" "$lang" "$id")" || die "no $kind exercise '$id' in $lang"
  local wd src; wd="$(work_dir "$kind" "$lang" "$name")"; src="$(ref_path "$kind" "$lang" "$name")"
  [[ -d "$wd" ]] || die "not started: ol start $kind $lang $id"
  echo "${DIM}Reference on the right. Different is not the same as worse.${RST}"
  echo
  if [[ -d "$src" ]]; then
    local f
    while IFS= read -r f; do
      diff -u --label "yours: ${f#$src/}" "$wd/${f#$src/}" \
              --label "reference: ${f#$src/}" <(drop_markers "$f") 2>/dev/null
    done < <(find "$src" -type f ! -name '_ss_*' | sort)
  else
    diff -u --label "yours" "$wd/$(basename "$src")" --label reference <(drop_markers "$src")
  fi
  return 0
}

cmd_show() {
  local kind="$1" lang="$2" id="$3"
  valid_kind "$kind"; lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  local name; name="$(resolve_name "$kind" "$lang" "$id")" || die "no $kind exercise '$id' in $lang"
  local src; src="$(ref_path "$kind" "$lang" "$name")"
  if [[ -d "$src" ]]; then
    local f
    while IFS= read -r f; do
      echo "${BLD}$(rel "$f")${RST}"; echo; drop_markers "$f"; echo
    done < <(find "$src" -type f ! -name '_ss_*' | sort)
  else
    echo "${BLD}$(rel "$src")${RST}"; echo; drop_markers "$src"
  fi
}

cmd_reveal() {
  local kind="$1" lang="$2" id="$3"
  valid_kind "$kind"; lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  local name; name="$(resolve_name "$kind" "$lang" "$id")" || die "no $kind exercise '$id' in $lang"
  case "$kind" in
    predict)   run_snippet "$lang" "$name" ;;
    build)     run_build_dir "$(ref_path build "$lang" "$name")" "$lang" ;;
    reattempt) run_reattempt_file "$(ref_path reattempt "$lang" "$name")" ;;
  esac
}

cmd_reset() {
  local kind="$1" lang="$2" id="$3"
  valid_kind "$kind"; lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  local name; name="$(resolve_name "$kind" "$lang" "$id")" || die "no $kind exercise '$id' in $lang"
  local t
  if [[ "$kind" == predict ]]; then t="$(pred_file "$lang" "$name")"; else t="$(work_dir "$kind" "$lang" "$name")"; fi
  [[ -e "$t" ]] || die "nothing to reset at $(rel "$t")"
  case "$t" in "$SCRATCH"/*) ;; *) die "refusing to delete outside the scratchpad: $t" ;; esac
  rm -rf "$t" && echo "cleared $(rel "$t")"
}

# ---------------------------------------------------------------------------
# list, score
# ---------------------------------------------------------------------------

cmd_list() {
  local kind="$1" lang="$2"
  lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  local total; total="$(all_names "$kind" "$lang" | wc -l | tr -d ' ')"
  [[ "$total" -gt 0 ]] || return 0
  printf '%s\n' "${BLD}$kind/$lang${RST}"
  local n
  while IFS= read -r n; do
    if attempted "$kind" "$lang" "$n"; then
      printf '  %-38s %s\n' "$n" "${GRN}started${RST}"
    else
      printf '  %-38s %s\n' "$n" "${DIM}--${RST}"
    fi
  done < <(all_names "$kind" "$lang")
}

cmd_score() {
  local kind="$1" lang="$2"
  lang="$(norm_lang "$kind" "$lang")"; valid_lang "$kind" "$lang"
  local n pass=0 fail=0 todo=0
  while IFS= read -r n; do
    check_one "$kind" "$lang" "$n" quiet >/dev/null 2>&1
    case $? in 0) pass=$((pass+1)) ;; 1) fail=$((fail+1)) ;; *) todo=$((todo+1)) ;; esac
  done < <(all_names "$kind" "$lang")
  [[ $((pass+fail+todo)) -gt 0 ]] || return 0
  local done_n=$((pass+fail))
  printf '%-22s %s%d passing%s  %s%d failing%s  %s%d not attempted%s' \
    "${BLD}$kind/$lang${RST}" "$GRN" "$pass" "$RST" "$RED" "$fail" "$RST" "$DIM" "$todo" "$RST"
  [[ $done_n -gt 0 ]] && printf '   (%d%% of attempted)' $(( pass * 100 / done_n ))
  printf '\n'
}

# ---------------------------------------------------------------------------
# verify: the maintainer/CI check
#
# check validates you. verify validates the exercises, and it is the one that
# has to stay green in CI.
#
#   predict    every snippet builds, exits zero, prints something, and prints
#              the identical something three runs running. Nondeterministic
#              output cannot be predicted, so it fails the build.
#   build      every reference builds and its own assertions pass.
#   reattempt  every manifest row points at a file that exists and still runs.
#
# It prints no exercise output, only shapes and line counts, so it is safe to
# run on a fresh checkout without spoiling anything.
# ---------------------------------------------------------------------------

verify_predict() {
  local lang="$1"
  if ! prepare_predict "$lang"; then echo "${RED}FAIL${RST}  predict/$lang (build failed)"; return 1; fi
  local name out first rc=0 i
  while IFS= read -r name; do
    first=""
    for i in 1 2 3; do
      if ! out="$(run_snippet "$lang" "$name")"; then
        echo "${RED}FAIL${RST}  predict/$lang/$name (exited nonzero)"; rc=1; continue 2
      fi
      if [[ $i -eq 1 ]]; then first="$out"
      elif [[ "$out" != "$first" ]]; then
        echo "${RED}FLAKY${RST} predict/$lang/$name (run $i differed, so it is not predictable)"; rc=1; continue 2
      fi
    done
    if [[ -z "$first" ]]; then echo "${RED}EMPTY${RST} predict/$lang/$name (printed nothing)"; rc=1; continue; fi
    printf '%sOK%s    predict/%s/%s (%s lines, stable over 3 runs)\n' \
      "$GRN" "$RST" "$lang" "$name" "$(printf '%s\n' "$first" | wc -l | tr -d ' ')"
  done < <(all_names predict "$lang")
  return $rc
}

verify_build() {
  local lang="$1" name d out rc=0 dupes

  # An absent toolchain is reported as a skip rather than a failure, and says
  # what to install. Optional languages are not installed by default, so a
  # compile error from a missing compiler would otherwise look like a broken
  # exercise.
  if ! toolchain_probe "$lang"; then
    if is_optional_lang "$lang"; then
      echo "${DIM}skip${RST}  build/$lang (toolchain not installed; it is optional here)"
      return 0
    fi
    echo "${RED}FAIL${RST}  build/$lang (toolchain not installed, and this language is core)"
    return 1
  fi

  # Two exercises sharing a numeric prefix make `ol start build <lang> 03`
  # ambiguous: resolve_name takes the first match, so one of them becomes
  # unreachable from the CLI. Catch it here rather than letting someone wonder
  # why their exercise never opens.
  dupes="$(all_names build "$lang" | cut -d- -f1 | sort | uniq -d)"
  if [[ -n "$dupes" ]]; then
    local id
    while IFS= read -r id; do
      echo "${RED}FAIL${RST}  build/$lang (duplicate id $id: $(all_names build "$lang" | grep "^$id-" | tr '\n' ' '))"
    done <<<"$dupes"
    rc=1
  fi

  while IFS= read -r name; do
    d="$(ref_path build "$lang" "$name")"
    if [[ ! -f "$d/README.md" ]]; then
      echo "${RED}FAIL${RST}  build/$lang/$name (no README.md brief)"; rc=1; continue
    fi
    if ! find "$d" -type f -exec grep -Eql "$MARKER_RE" {} + >/dev/null 2>&1; then
      echo "${RED}FAIL${RST}  build/$lang/$name (no solution markers, so it cannot be stubbed)"; rc=1; continue
    fi
    if ! out="$(run_build_dir "$d" "$lang" 2>&1)"; then
      echo "${RED}FAIL${RST}  build/$lang/$name (reference does not pass its own assertions)"
      printf '%s\n' "$out" | tail -5 | sed 's/^/        /'
      rc=1; continue
    fi
    printf '%sOK%s    build/%s/%s\n' "$GRN" "$RST" "$lang" "$name"
  done < <(all_names build "$lang")
  return $rc
}

verify_reattempt() {
  local track="$1" name src rc=0
  while IFS= read -r name; do
    src="$(ref_path reattempt "$track" "$name")" || { echo "${RED}FAIL${RST}  reattempt/$track/$name (not in manifest)"; rc=1; continue; }
    if [[ ! -f "$src" ]]; then
      echo "${RED}FAIL${RST}  reattempt/$track/$name (source missing: $(rel "$src"))"; rc=1; continue
    fi
    if ! has_markers "$src"; then
      echo "${RED}FAIL${RST}  reattempt/$track/$name (no solution markers in $(rel "$src"))"; rc=1; continue
    fi
    if ! run_reattempt_file "$src" >/dev/null 2>&1; then
      echo "${RED}FAIL${RST}  reattempt/$track/$name (source does not run clean)"; rc=1; continue
    fi
    printf '%sOK%s    reattempt/%s/%s\n' "$GRN" "$RST" "$track" "$name"
  done < <(all_names reattempt "$track")
  return $rc
}

verify_kind_lang() {
  case "$1" in
    predict)   verify_predict "$2" ;;
    build)     verify_build "$2" ;;
    reattempt) verify_reattempt "$2" ;;
  esac
}

# ---------------------------------------------------------------------------
# bench: what the predict snippets cost
#
# check asks what a program prints. bench asks what it costs, which is the
# other half of a mental model and usually the half made of folklore.
#
#   1. Measure the program, not the toolchain. Go and Rust are built ahead of
#      time so the measured run has no compile step in it. Python and
#      TypeScript have no build step, so interpreter startup is a real part of
#      their cost and is left in.
#   2. Compare against a ceiling, not against each other. A breach means
#      something regressed. It does not mean one language beat another.
# ---------------------------------------------------------------------------

BENCH_RUNS="${OL_BENCH_RUNS:-${LR_BENCH_RUNS:-5}}"
BUDGETS="$PRACTICE/predict/budgets.tsv"
BENCH_TMP="$SCRATCH/.bench"

bench_prepare() {
  local lang="$1" name
  case "$lang" in
    go)
      mkdir -p "$BENCH_TMP/go"
      while IFS= read -r name; do
        (cd "$PRACTICE/predict/go" && go build -o "$BENCH_TMP/go/$name" "./predict/$name") || return 1
      done < <(all_names predict go) ;;
    rust) (cd "$PRACTICE/predict/rust/predict" && cargo build --quiet --bins) || return 1 ;;
    *)    : ;;
  esac
}

bench_measure() {
  local lang="$1" name="$2" m="$BIN_DIR/measure.py"
  case "$lang" in
    go)     python3 "$m" "$BENCH_RUNS" "$BENCH_TMP/go/$name" ;;
    rust)   python3 "$m" "$BENCH_RUNS" "$PRACTICE/predict/rust/predict/target/debug/$name" ;;
    python) python3 "$m" "$BENCH_RUNS" python3 "$PRACTICE/predict/python/predict/$name.py" ;;
    ts)     python3 "$m" "$BENCH_RUNS" node "$PRACTICE/predict/ts/predict/$name.ts" ;;
  esac
}

bench_budget() {
  awk -v lang="$1" -v name="$2" '
    /^[[:space:]]*(#|$)/ { next }
    $1 == lang && $2 == name { print $3 "\t" $4; exit }
  ' "$BUDGETS" 2>/dev/null
}

cmd_bench() {
  local lang="$1" strict="${2:-}"
  lang="$(norm_lang predict "$lang")"; valid_lang predict "$lang"
  if ! bench_prepare "$lang"; then echo "${RED}FAIL${RST}  $lang (build failed)"; return 1; fi
  local name measured ms kb budget max_ms max_kb status rc=0
  while IFS= read -r name; do
    if ! measured="$(bench_measure "$lang" "$name")"; then
      echo "${RED}FAIL${RST}  $lang/$name (exited nonzero)"; rc=1; continue
    fi
    read -r ms kb <<<"$measured"
    budget="$(bench_budget "$lang" "$name")"
    if [[ -z "$budget" ]]; then
      status="${DIM}no budget${RST}"
    else
      read -r max_ms max_kb <<<"$budget"
      status="${GRN}ok${RST}"
      if [[ "$ms" -gt "$max_ms" ]]; then
        status="${RED}over time (max ${max_ms}ms)${RST}"; [[ -n "$strict" ]] && rc=1
      elif [[ "$kb" -gt "$max_kb" ]]; then
        status="${RED}over memory (max ${max_kb}KB)${RST}"; [[ -n "$strict" ]] && rc=1
      fi
    fi
    printf '  %-34s %6sms %8sKB  %s\n' "$name" "$ms" "$kb" "$status"
  done < <(all_names predict "$lang")
  return $rc
}

cmd_where() {
  printf '%-12s %s\n' repo "$ROOT"
  printf '%-12s %s\n' practice "$PRACTICE"
  printf '%-12s %s%s\n' scratchpad "$SCRATCH" "$([[ -d "$SCRATCH" ]] || echo "  ${DIM}(not created yet)${RST}")"
  printf '%-12s %s\n' manifest "$(rel "$MANIFEST")"
  echo
  local kind lang tag
  for kind in $KINDS; do
    for lang in $(langs_all_for "$kind"); do
      if [[ "$kind" == build ]] && is_optional_lang "$lang"; then
        if toolchain_probe "$lang"; then tag="${DIM}optional${RST}"; else tag="${DIM}optional, no toolchain${RST}"; fi
      elif ! toolchain_probe "$lang"; then
        tag="${RED}toolchain missing${RST}"
      else
        tag=""
      fi
      printf '  %-10s %-12s %2s exercises  %s\n' \
        "$kind" "$lang" "$(all_names "$kind" "$lang" | wc -l | tr -d ' ')" "$tag"
    done
  done
  echo
  printf '  %s\n' "${DIM}core build languages:     $(langs_build_core)${RST}"
  printf '  %s\n' "${DIM}optional build languages: $(langs_build_optional) (excluded from bare 'ol verify build')${RST}"
}

# ---------------------------------------------------------------------------
# Learn
#
# A path is content/courses/build-an-llm/paths/<name>/path.tsv, one row per stage, tab-separated as
#   stage  title  files  done-when  [check]
# where files is a comma-separated list of repo-relative markdown files read in
# order. The optional fifth column ties the stage to a verdict (course/DESIGN.md
# 5.15): module:<ID>, solve:<ID>, milestone:<ID>, drill:<ID>, conform:<suite>,
# all:<ID>,<ID>, or -. A stage with a check is marked done only when the check
# passes (--force marks it anyway and logs that in <path>.done.log). A row whose first column is @<other> pulls in every stage of path
# <other>, so a role is assembled from parts: the parts stay usable on their
# own and progress made in a part counts in every path that includes it.
#
# Stages are addressed as <n> for a path's own stages and <part>:<n> for an
# included one. Progress is one stage number per line in
# .scratchpad/learn/<owning path>.done.

PATHS_DIR="${OL_PATHS_DIR:-$ROOT/content/courses/build-an-llm/paths}"
# Stage files are repo-relative. Custom path trees retain the adjacent-root convention.
if [[ -n "${OL_LEARN_ROOT:-}" ]]; then
  LEARN_ROOT="$OL_LEARN_ROOT"
elif [[ -n "${OL_PATHS_DIR:-}" ]]; then
  LEARN_ROOT="$(cd "$PATHS_DIR/.." 2>/dev/null && pwd)"
else
  LEARN_ROOT="$ROOT"
fi
COURSE_ROOT="${OL_COURSE_ROOT:-$ROOT/course}"

path_names() {
  local f
  for f in "$PATHS_DIR"/*/path.tsv; do [[ -f "$f" ]] && basename "$(dirname "$f")"; done
}
path_tsv() {
  local f="$PATHS_DIR/$1/path.tsv"
  [[ -f "$f" ]] || die "no path '$1' (have: $(path_names | tr '\n' ' '))"
  echo "$f"
}
path_title() { sed -n 's/^# //p' "$PATHS_DIR/$1/README.md" 2>/dev/null | head -1; }
# Progress on a course path belongs to the learner repo it was earned in
# (DESIGN 5.15): with one active (system.toml at OL_COURSE_HOME, default
# .scratchpad/course) course-* paths keep their done files in its .ol/learn/.
learn_dir() {
  local home="${OL_COURSE_HOME:-$ROOT/.scratchpad/course}"
  if [[ "$1" == course* && -f "$home/system.toml" ]]; then
    echo "$home/.ol/learn"
  else
    echo "$SCRATCH/learn"
  fi
}
learn_done_file() { echo "$(learn_dir "$1")/$1.done"; }
is_done() { grep -qx "$2" "$(learn_done_file "$1")" 2>/dev/null; }

# Every stage of a path with includes resolved, one row per stage:
#   owner  stage  title  files  done-when  check
# Prints a diagnostic and fails on an unknown include or a cycle; callers run
# it inside $(...) and must propagate the failure themselves.
expand_rows() {
  local name="$1" stack="${2:-}" tsv stage title files when check
  tsv="$PATHS_DIR/$name/path.tsv"
  local chain="${stack# }"; chain="${chain// / -> }"
  [[ -f "$tsv" ]] || { echo "${RED}error:${RST} unknown path '$name'${chain:+ (included from $chain)}" >&2; return 1; }
  [[ " $stack " == *" $name "* ]] && { echo "${RED}error:${RST} include cycle: $chain -> $name" >&2; return 1; }
  while IFS=$'\t' read -r stage title files when check; do
    [[ -z "$stage" || "$stage" == \#* ]] && continue
    if [[ "$stage" == @* ]]; then
      expand_rows "${stage#@}" "$stack $name" || return 1
    else
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$stage" "$title" "$files" "$when" "${check:--}"
    fi
  done < "$tsv"
}

# The address a reader types for a stage of <top>: n for its own, part:n otherwise.
stage_key() { if [[ "$2" == "$1" ]]; then echo "$3"; else echo "$2:$3"; fi; }

learn_list() {
  local name rows total done parts
  for name in $(path_names); do
    rows="$(expand_rows "$name")" || { printf '  %-24s %s\n' "$name" "${RED}broken (run ol learn --verify)${RST}"; continue; }
    total="$(grep -c . <<<"$rows")"
    done=0
    while IFS=$'\t' read -r owner stage _; do is_done "$owner" "$stage" && done=$((done + 1)); done <<<"$rows"
    parts="$(cut -f1 <<<"$rows" | sort -u | grep -vx "$name" | wc -l | tr -d ' ')"
    printf '  %-24s %3s/%-3s %s%s\n' "$name" "$done" "$total" "$(path_title "$name")" \
      "$([[ $parts -gt 0 ]] && echo "  ${DIM}(composes $parts parts)${RST}")"
  done
}

# Forced marks (ol learn <path> --done <stage> --force) are logged here.
learn_force_log() { echo "$(learn_dir "$1")/$1.done.log"; }
is_forced() { awk -F'\t' -v s="$2" '$1 == s' "$(learn_force_log "$1")" 2>/dev/null | grep -q .; }

learn_stages() {
  local top="$1" rows owner stage title files when check mark prev="" states=""
  rows="$(expand_rows "$top")" || exit 1
  # One harness call answers every done stage that carries a check, so a path
  # with no check column never starts the course harness.
  local pending
  pending="$(while IFS=$'\t' read -r owner stage title files when check; do
    [[ -n "$check" && "$check" != - ]] && is_done "$owner" "$stage" && echo "$check"
  done <<<"$rows" | sort -u)"
  [[ -n "$pending" ]] && states="$(course_q _learn-status <<<"$pending" 2>/dev/null)"
  printf '%s\n' "${BLD}$(path_title "$top")${RST}"
  while IFS=$'\t' read -r owner stage title files when check; do
    if [[ "$owner" != "$prev" ]]; then
      printf '\n  %s\n' "${YEL}$( [[ "$owner" == "$top" ]] && echo "$top" || echo "part: $owner")  ${DIM}$(path_title "$owner")${RST}"
      prev="$owner"
    fi
    mark="[ ]"
    if is_done "$owner" "$stage"; then
      mark="${GRN}[x]${RST}"
      if is_forced "$owner" "$stage"; then
        mark="${YEL}[~]${RST}"
      elif [[ -n "$check" && "$check" != - ]]; then
        case "$(awk -F'\t' -v c="$check" '$1 == c { print $2; exit }' <<<"$states")" in
          pass) ;;
          *)    mark="${YEL}[~]${RST}" ;;   # assisted, self-graded, spoiled, or no verdict
        esac
      fi
    fi
    printf '  %s %-26s %s\n' "$mark" "$(stage_key "$top" "$owner" "$stage")" "${BLD}$title${RST}"
    printf '      %s\n' "${DIM}${files//,/  }${RST}"
    printf '      done when: %s\n' "$when"
    [[ -n "$check" && "$check" != - ]] && printf '      check:     %s\n' "$check"
  done <<<"$rows"
  printf '\n%s\n' "${DIM}read a stage: ol learn $top <stage|next>    mark it: ol learn $top --done <stage>${RST}"
}

# Resolve a typed stage address to one expanded row, or die.
find_row() {
  local top="$1" key="$2" rows row
  rows="$(expand_rows "$top")" || exit 1
  if [[ "$key" == next ]]; then
    while IFS=$'\t' read -r owner stage _; do
      is_done "$owner" "$stage" || { grep -m1 "^$owner"$'\t'"$stage"$'\t' <<<"$rows"; return 0; }
    done <<<"$rows"
    return 0
  fi
  local owner="$top" stage="$key"
  [[ "$key" == *:* ]] && { owner="${key%%:*}"; stage="${key#*:}"; }
  row="$(awk -F'\t' -v o="$owner" -v s="$stage" '$1 == o && $2 == s' <<<"$rows")"
  [[ -n "$row" ]] || die "path '$top' has no stage '$key' (list them with: ol learn $top)"
  echo "$row"
}

# Markdown to the terminal: glow when it exists and we own a terminal, plain
# text otherwise, so piping into a file or another tool stays clean.
render_md() {
  if [[ -t 1 ]] && command -v glow >/dev/null 2>&1; then
    glow -p "$@"
  elif [[ -t 1 ]]; then
    cat "$@" | "${PAGER:-less}"
  else
    cat "$@"
  fi
}

learn_read() {
  local top="$1" row owner stage title files when check f
  # die inside $(...) only leaves the subshell, so propagate it by hand.
  row="$(find_row "$top" "$2")" || exit 1
  [[ -n "$row" ]] || { echo "${GRN}every stage of '$top' is done${RST}"; return 0; }
  IFS=$'\t' read -r owner stage title files when check <<<"$row"
  local paths=() list
  IFS=',' read -ra list <<<"$files"
  for f in "${list[@]}"; do
    [[ -f "$LEARN_ROOT/$f" ]] || die "stage $(stage_key "$top" "$owner" "$stage") names '$f', which does not exist"
    paths+=("$LEARN_ROOT/$f")
  done
  printf '%s\n' "${BLD}stage $(stage_key "$top" "$owner" "$stage"): $title${RST}" >&2
  printf '%s\n\n' "${DIM}done when: $when${RST}" >&2
  render_md "${paths[@]}"
}

learn_mark() {
  local top="$1" flag="$2" force="${4:-}" row owner stage title files when check file
  row="$(find_row "$top" "$3")" || exit 1
  IFS=$'\t' read -r owner stage title files when check <<<"$row"
  file="$(learn_done_file "$owner")"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  if [[ "$flag" == --done ]]; then
    if [[ -n "$check" && "$check" != - ]]; then
      if [[ -n "$force" ]]; then
        printf '%s\tforced\t%s\t%s\n' "$stage" "$check" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$(learn_force_log "$owner")"
        echo "${YEL}forced:${RST} $check has no passing verdict; logged in $(rel "$(learn_force_log "$owner")")"
      elif ! course_q _learn-check "$check"; then
        echo "${RED}not marked:${RST} stage $(stage_key "$top" "$owner" "$stage") needs $check to pass (--force marks it anyway, and logs that)"
        return 1
      else
        unforce "$owner" "$stage"
      fi
    fi
    is_done "$owner" "$stage" || echo "$stage" >> "$file"
    echo "${GRN}stage $(stage_key "$top" "$owner" "$stage") done${RST}${owner:+$([[ "$owner" != "$top" ]] && echo " ${DIM}(counts in every path that includes $owner)${RST}")}"
  else
    grep -vx "$stage" "$file" > "$file.tmp" || true
    mv "$file.tmp" "$file"
    unforce "$owner" "$stage"
    echo "stage $(stage_key "$top" "$owner" "$stage") unmarked"
  fi
}

# Drop a stage's forced-mark entries (an undo, or a later real pass).
unforce() {
  local log; log="$(learn_force_log "$1")"
  [[ -f "$log" ]] || return 0
  awk -F'\t' -v s="$2" '$1 != s' "$log" > "$log.tmp" || true
  mv "$log.tmp" "$log"
}

# A check column value resolves to something the harness can run.
check_resolves() {
  local check="$1" kind target id
  [[ -z "$check" || "$check" == - ]] && return 0
  kind="${check%%:*}"; target="${check#*:}"
  [[ "$check" == *:* && -n "$target" ]] || { echo "malformed check '$check' (want kind:target)"; return 1; }
  case "$kind" in
    module|solve)
      [[ -f "$COURSE_ROOT/modules/$target.toml" ]] || { echo "check $check: no module $target in $(rel "$COURSE_ROOT")/modules"; return 1; } ;;
    milestone)
      [[ -f "$COURSE_ROOT/milestones/$target.toml" ]] || { echo "check $check: no milestone $(rel "$COURSE_ROOT")/milestones/$target.toml"; return 1; } ;;
    drill)
      [[ -f "$COURSE_ROOT/modules/$target.toml" || -f "$COURSE_ROOT/drills/$target/drill.toml" ]] || { echo "check $check: no drill $target"; return 1; } ;;
    conform)
      case "$target" in
        openapi*) [[ -d "$COURSE_ROOT/contracts/openapi" ]] || { echo "check $check: no contracts/openapi"; return 1; } ;;
        *)        [[ -d "$COURSE_ROOT/conformance/${target%%:*}" ]] || { echo "check $check: no conformance suite ${target%%:*}"; return 1; } ;;
      esac ;;
    all)
      local IFS=','
      for id in $target; do
        [[ -f "$COURSE_ROOT/modules/$id.toml" ]] || { echo "check $check: no module $id"; return 1; }
      done ;;
    *) echo "check '$check': unknown kind '$kind' (want module, solve, milestone, drill, conform, all, or -)"; return 1 ;;
  esac
}

learn_verify() {
  local name rows owner stage title files when check f rc=0 bad list why
  [[ -n "$(path_names)" ]] || die "no paths under $(rel "$PATHS_DIR")"
  for name in $(path_names); do
    bad=0
    [[ -n "$(path_title "$name")" ]] || { echo "${RED}FAIL${RST} $name: README.md has no '# ' title"; bad=1; }
    if ! rows="$(expand_rows "$name")"; then
      echo "${RED}FAIL${RST} $name: includes do not resolve"; rc=1; continue
    fi
    # A stage number may appear once per owning path.
    while read -r dup; do
      [[ -n "$dup" ]] && { echo "${RED}FAIL${RST} $name: stage $dup appears twice"; bad=1; }
    done < <(awk -F'\t' '$1 == "'"$name"'" {print $2}' <<<"$rows" | sort | uniq -d)
    while IFS=$'\t' read -r owner stage title files when check; do
      [[ "$owner" == "$name" ]] || continue   # included stages are checked under their own path
      [[ "$stage" =~ ^[0-9]+$ ]] || { echo "${RED}FAIL${RST} $name: stage '$stage' is not a number"; bad=1; }
      [[ -n "$title" && -n "$files" && -n "$when" ]] || { echo "${RED}FAIL${RST} $name stage $stage: empty column"; bad=1; }
      IFS=',' read -ra list <<<"$files"
      for f in "${list[@]}"; do
        [[ -f "$LEARN_ROOT/$f" ]] || { echo "${RED}FAIL${RST} $name stage $stage: missing $f"; bad=1; }
      done
      why="$(check_resolves "$check")" || { echo "${RED}FAIL${RST} $name stage $stage: $why"; bad=1; }
    done <<<"$rows"
    if [[ $bad -eq 0 ]]; then
      echo "${GRN}ok${RST}   $name ($(grep -c . <<<"$rows") stages)"
    else
      rc=1
    fi
  done
  return $rc
}

cmd_learn() {
  # Resolve the path name here, outside any $(...), so an unknown name dies
  # instead of leaving later reads with nothing to read.
  [[ $# -ge 1 && "$1" != --verify ]] && path_tsv "$1" >/dev/null
  case $# in
    0) learn_list ;;
    1) [[ "$1" == --verify ]] && { learn_verify; return; }
       learn_stages "$1" ;;
    2) learn_read "$1" "$2" ;;
    3|4)
       [[ $# -eq 4 && "$4" != --force ]] && die "usage: ol learn <path> --done <stage> [--force]"
       case "$2" in
         --done|--undo) learn_mark "$1" "$2" "$3" "${4:-}" ;;
         *) die "usage: ol learn <path> --done|--undo <stage>" ;;
       esac ;;
    *) die "usage: ol learn [<path> [<stage>|next|--done <stage> [--force]|--undo <stage>]]" ;;
  esac
}

usage() { awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }

# Fan a per-(kind,lang) function out over everything, or over one kind, or one
# kind and language, depending on how many arguments the user gave.
fan_out() {
  local fn="$1"; shift
  local kind lang rc=0
  if [[ $# -eq 0 ]]; then
    for kind in $KINDS; do for lang in $(langs_for "$kind"); do "$fn" "$kind" "$lang" || rc=1; done; done
  elif [[ $# -eq 1 ]]; then
    valid_kind "$1"
    for lang in $(langs_for "$1"); do "$fn" "$1" "$lang" || rc=1; done
  else
    valid_kind "$1"; "$fn" "$1" "$(norm_lang "$1" "$2")" || rc=1
  fi
  return $rc
}

[[ $# -ge 1 ]] || { usage; exit 1; }
sub="$1"; shift

# ---------------------------------------------------------------------------
# Course modules (course/DESIGN.md 5.2). One branch ahead of the practice
# dispatch: a verb whose first argument is a course id, or a course-only verb,
# goes to python -m olcourse in the uv project course/harness. None of the
# practice kinds (predict, build, reattempt) match COURSE_ID_RE, so
# `ol start build c 02` and `ol bench [lang]` keep their meaning.
# ---------------------------------------------------------------------------

COURSE_ID_RE='^(M[0-9]{2}\.[0-9]{1,2}|L[0-9]{1,2}\.[0-9]|C[12]|S-M[0-9]{2}[a-z]?|(lang|ds|rt|data|dur|gw|ag|load|dep|obs|ops|craft|ethics|review|field|iv)\.[0-9]{2}|sq\.[a-z0-9-]+|MS-[A-Za-z0-9-]+)(\+cuda)?$'
course_q() {
  command -v uv >/dev/null 2>&1 || { echo "${RED}error:${RST} the course harness needs uv (https://docs.astral.sh/uv/)" >&2; return 5; }
  OL_ROOT="$ROOT" uv run --project "$ROOT/course/harness" --quiet python -m olcourse "$@"
}
course() { course_q "$@"; exit $?; }

case "$sub" in
  start|check|diff|show|reset|reveal|tests)
    [[ "${1:-}" =~ $COURSE_ID_RE || "${1:-}" == --all ]] && course "$sub" "$@" ;;
  bench)          # the existing `ol bench [lang] [--assert]` (predict budgets) keeps its meaning
    [[ "${1:-}" =~ $COURSE_ID_RE || "${1:-}" == course || "${1:-}" == --calibrate ]] && course "$sub" "$@" ;;
  course|status|next|milestone|conform|parity|mutate|tdd|export|drill|fetch|contracts|doctor|lint|stub|_learn-status|_learn-check)
    course "$sub" "$@" ;;
  verify) [[ "${1:-}" == course ]] && course "$sub" "$@" ;;
esac

case "$sub" in
  start)  [[ $# -eq 3 ]] || die "usage: ol start <kind> <lang> <id>";  cmd_start "$@" ;;
  check)  [[ $# -ge 2 ]] || die "usage: ol check <kind> <lang> [id]";  cmd_check "$@" ;;
  diff)   [[ $# -eq 3 ]] || die "usage: ol diff <kind> <lang> <id>";   cmd_diff "$@" ;;
  show)   [[ $# -eq 3 ]] || die "usage: ol show <kind> <lang> <id>";   cmd_show "$@" ;;
  reveal) [[ $# -eq 3 ]] || die "usage: ol reveal <kind> <lang> <id>"; cmd_reveal "$@" ;;
  reset)  [[ $# -eq 3 ]] || die "usage: ol reset <kind> <lang> <id>";  cmd_reset "$@" ;;
  list)   fan_out cmd_list "$@" ;;
  score)  fan_out cmd_score "$@" ;;
  verify) fan_out verify_kind_lang "$@" ;;
  bench)  strict=""; blang=""
          for arg in "$@"; do
            case "$arg" in
              --assert) strict=1 ;;
              -*)       die "unknown flag '$arg' (want: --assert)" ;;
              *)        blang="$arg" ;;
            esac
          done
          if [[ -n "$blang" ]]; then
            printf '%s\n' "${BLD}$blang${RST}"; cmd_bench "$blang" "$strict"
          else
            rc=0
            for l in $(langs_predict); do printf '%s\n' "${BLD}$l${RST}"; cmd_bench "$l" "$strict" || rc=1; done
            exit $rc
          fi ;;
  learn)  cmd_learn "$@" ;;
  where)  cmd_where ;;
  -h|--help|help) usage ;;
  *)      die "unknown subcommand '$sub'" ;;
esac
