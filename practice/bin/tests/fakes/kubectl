#!/usr/bin/env python3
"""A stateful fake kubectl for the drill and milestone self-tests.

State lives in $FAKE_KUBE_STATE (JSON); every invocation is appended to
$FAKE_KUBE_LOG. Supports exactly what the harness issues: config
current-context, get (namespace, deploy, statefulset, pods -l, configmap) -o
json, delete pod, scale, patch (--type=json add/remove, --type=merge on
configmaps), rollout restart, rollout status (fails for a target listed in
the state's "rollout_failing").
"""

import json
import os
import sys


def main(argv):
    state_path = os.environ["FAKE_KUBE_STATE"]
    with open(state_path) as f:
        st = json.load(f)
    with open(os.environ["FAKE_KUBE_LOG"], "a") as f:
        f.write(json.dumps(argv) + "\n")
    context, ns, rest, i = None, None, [], 0
    while i < len(argv):
        a = argv[i]
        if a == "--context":
            context = argv[i + 1]; i += 2; continue
        if a == "-n":
            ns = argv[i + 1]; i += 2; continue
        rest.append(a); i += 1
    if rest[:2] == ["config", "current-context"]:
        print(st["current_context"]); return 0
    if context is not None and context not in st["contexts"]:
        print(f"error: context {context!r} does not exist", file=sys.stderr); return 1
    space = st["namespaces"].get(ns) if ns else None
    verb = rest[0]
    out = "-o" in rest and rest[rest.index("-o") + 1] == "json"

    def obj(ref):
        kind, _, name = ref.partition("/")
        table = {"deploy": "deployments", "deployment": "deployments", "statefulset": "statefulsets",
                 "configmap": "configmaps"}[kind]
        o = space.get(table, {}).get(name)
        if o is None:
            print(f'Error from server (NotFound): {kind} "{name}" not found', file=sys.stderr)
            sys.exit(1)
        return o

    if verb == "get":
        what = rest[1]
        if what in ("namespace", "ns"):
            if rest[2] in st["namespaces"]:
                print(f"{rest[2]}   Active"); return 0
            print(f'Error from server (NotFound): namespaces "{rest[2]}" not found', file=sys.stderr); return 1
        if space is None:
            print("error: namespace missing", file=sys.stderr); return 1
        if what == "pods":
            sel = dict(x.split("=") for x in rest[rest.index("-l") + 1].split(","))
            items = [p for p in space["pods"] if all(p["metadata"]["labels"].get(k) == v for k, v in sel.items())]
            print(json.dumps({"items": items})); return 0
        print(json.dumps(obj(what)) if out else what); return 0
    if verb == "delete" and rest[1] == "pod":
        name = rest[2]
        pods = space["pods"]
        victim = next((p for p in pods if p["metadata"]["name"] == name), None)
        if victim is None:
            print(f'pods "{name}" not found', file=sys.stderr); return 1
        pods.remove(victim)
        repl = json.loads(json.dumps(victim))
        repl["metadata"]["name"] = name + "-r"
        pods.append(repl)  # the controller replaces it
        st.setdefault("deleted", []).append(name)
    elif verb == "scale":
        o = obj(rest[1])
        o["spec"]["replicas"] = int(next(a for a in rest if a.startswith("--replicas=")).split("=")[1])
    elif verb == "patch":
        o = obj(rest[1])
        typ = next(a for a in rest if a.startswith("--type=")).split("=")[1]
        patch = json.loads(rest[rest.index("-p") + 1])
        if typ == "json":
            for op in patch:
                parts = [p for p in op["path"].split("/") if p]
                node = o
                for p in parts[:-1]:
                    node = node[int(p)] if isinstance(node, list) else node.setdefault(p, {})
                key = parts[-1]
                if op["op"] in ("add", "replace"):
                    node[key] = op["value"]
                elif op["op"] == "remove":
                    del node[key]
        else:
            data = o.setdefault("data", {})
            for k, v in patch.get("data", {}).items():
                if v is None:
                    data.pop(k, None)
                else:
                    data[k] = v
    elif verb == "debug":
        st.setdefault("debug", []).append(rest[1:])
    elif verb == "apply":
        with open(rest[rest.index("-f") + 1]) as f:
            doc = json.load(f)
        st.setdefault("applied", []).extend(doc.get("items", [doc]))
    elif verb == "wait":
        print(f"{rest[-2] if rest[-1].startswith('--timeout') else rest[-1]} condition met")
        return 0
    elif verb == "logs":
        print(st.get("job_logs", ""))
        return 0
    elif verb == "delete" and rest[1] in ("job", "configmap"):
        st.setdefault("deleted_objects", []).append(f"{rest[1]}/{rest[2]}")
    elif verb == "rollout" and rest[1] == "status":
        if rest[2] in st.get("rollout_failing", []):
            print(f"error: {rest[2]} exceeded its progress deadline", file=sys.stderr)
            return 1
        print(f'{rest[2]} successfully rolled out')
        return 0
    elif verb == "rollout" and rest[1] == "restart":
        o = obj(rest[2])
        o.setdefault("restarts", 0)
        o["restarts"] += 1
    else:
        print(f"fake kubectl: unsupported {rest}", file=sys.stderr); return 2
    with open(state_path, "w") as f:
        json.dump(st, f, indent=1)
    print("ok")
    return 0


sys.exit(main(sys.argv[1:]))
