#!/usr/bin/env bash
# Artifact check for craft.03 (DESIGN 4.6; H15: `ol check craft.03` runs this
# in your repo and its exit code is the verdict).
#
# Two parts, both annotated tests next to this file (`ol tests craft.03`):
#   test_craft03_kata.py     the course's tests of YOUR kata code,
#                            primers/craft.03/failpoints.py
#   test_craft03_grading.py  the grade of YOUR tests,
#                            primers/craft.03/test_failpoints.py: they must
#                            pass on your code and on the course's kata, and
#                            catch at least 70% of the planted faults in
#                            course/mutants/craft.03 (the one marked required
#                            among them), one fault at a time.
# Your kata needs only the standard library; the check brings pytest.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
dir="$PWD/primers/craft.03"

fail() { echo "craft.03: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
[ -f "$dir/failpoints.py" ] || fail "primers/craft.03/failpoints.py is missing: run \`ol start craft.03\`"
[ -f "$dir/test_failpoints.py" ] || fail "primers/craft.03/test_failpoints.py is missing: your tests are the artifact (chapter, section 4)"

export OL_PRIMER_DIR="$dir" PYTHONPATH="$dir:$tests" PYTHONDONTWRITEBYTECODE=1
exec uv run --no-project --quiet --with pytest \
  python -m pytest -q -p no:cacheprovider -p no:randomly --rootdir="$tests" --confcutdir="$tests" "$here"
