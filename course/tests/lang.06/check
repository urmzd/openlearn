#!/usr/bin/env bash
# Artifact check for the lang.06 Go primer (DESIGN 4.6, deviation H15).
#
# Runs in your learner repo. Copies your primers/lang.06/*.go (not your own
# _test.go files) into a scratch module named lang06, adds the course tests
# from $OL_COURSE_TREE/tests/go/lang_06/, and runs `go vet` and
# `go test -race` with the `primer` tag. The exit code is the verdict.
set -euo pipefail

src=primers/lang.06
tests="${OL_COURSE_TREE:?OL_COURSE_TREE is set by ol check}/tests/go/lang_06"

command -v go >/dev/null || { echo "go is not installed (ol doctor)"; exit 5; }
shopt -s nullglob
files=()
for f in "$src"/*.go; do
  case "$f" in *_test.go) ;; *) files+=("$f") ;; esac
done
if [ ${#files[@]} -eq 0 ]; then
  echo "$src/ has no .go files: run \`ol start lang.06\` and write $src/proxy.go"
  exit 1
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cp "${files[@]}" "$work/"
cp "$tests"/*_test.go "$work/"
printf 'module lang06\n\ngo 1.22\n' > "$work/go.mod"

export GOTOOLCHAIN=local GOFLAGS=-count=1 GOWORK=off
race=(-race)
[ "${OL_GO_RACE:-1}" = 0 ] && race=()

cd "$work"
echo "go vet -tags primer"
go vet -tags primer ./... || { echo "lang.06: go vet rejects the code (see above)"; exit 1; }
echo "go test ${race[*]} -tags primer"
rc=0
go test "${race[@]}" -tags primer -v ./... > test.log 2>&1 || rc=$?
grep -vE '^=== (RUN|PAUSE|CONT)' test.log || true
if [ "$rc" -ne 0 ]; then
  echo "lang.06: the course tests fail"
  exit 1
fi
echo "lang.06: your streaming proxy honors its deadline"
