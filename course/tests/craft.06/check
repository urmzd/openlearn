#!/usr/bin/env bash
# ol-export: course-tree (grades against the course's reference katas, never exported)
# Artifact check for craft.06 (DESIGN 4.6, rung R7; `ol check craft.06` runs
# this in your repo and its exit code is the verdict).
#
# It grades YOUR benchmark and performance gate in primers/craft.06/
# (bench.c, budget.toml, gate.py; read the test catalog with
# `ol tests craft.06`): the gate passes when base and head are both the
# course's kata (no false alarm, twice), it passes your kata against the
# course's (yours keeps pace), and it fails against each of the ten planted
# slowdowns in course/mutants/craft.06 (loop order, tiles too small,
# duplicated work, one accumulator, volatile partial sums, an O(d^2) norm, a
# linear search, a defensive copy). Rung R7: at least 0.90 of them, and
# s01, s02, s04, and s09 always. Your kata itself must also be correct
# (course/tests/craft.06/kata_check.c).
#
# The first run writes primers/craft.06/kernels.h (the given spec) and
# primers/craft.06/kernels.c (every body stubbed by the harness's stubber)
# when they are missing, so the first run fails. It never overwrites a file.
# Every build and benchmark runs in its own process group with a timeout.
# Benchmarks are timing: run the check on an otherwise idle machine.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"
dir="$PWD/primers/craft.06"

fail() { echo "craft.06: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
command -v cc >/dev/null || fail "cc is not on PATH (ol doctor)"
[ -f "$course/ref/primers/craft.06/kernels.c" ] ||
  fail "the course tree at $course has no craft.06 kata: this check runs inside a openlearn checkout (OL_COURSE_TREE)"

mkdir -p "$dir"
if [ ! -f "$dir/kernels.h" ]; then
  cp "$course/ref/primers/craft.06/kernels.h" "$dir/kernels.h"
  echo "  wrote     primers/craft.06/kernels.h  (the kata's spec: given)"
fi
if [ ! -f "$dir/kernels.c" ]; then
  uv run --no-project --quiet python - "$course" "$dir" <<'PY' || fail "could not write the starter kata"
import sys
from pathlib import Path
course, dest = Path(sys.argv[1]), Path(sys.argv[2])
sys.path.insert(0, str(course / "harness" / "src"))
from olcourse import markers
text = (course / "ref" / "primers" / "craft.06" / "kernels.c").read_text()
(dest / "kernels.c").write_text(markers.stub(text, "primers/craft.06/kernels.c", want="craft.06"))
print("  wrote     primers/craft.06/kernels.c  (stub: yours to write)")
PY
fi

export OL_PRIMER_DIR="$dir" OL_COURSE_TREE="$course" OL_LEARNER_ROOT="$PWD" PYTHONDONTWRITEBYTECODE=1
exec uv run --no-project --quiet --with pytest \
  python -m pytest -q --tb=short -p no:cacheprovider -p no:randomly --rootdir="$tests" --confcutdir="$tests" "$here"
