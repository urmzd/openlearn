#!/usr/bin/env bash
# Artifact check for ethics.01 (DESIGN 4.6, 6.4; H15: `ol check ethics.01`
# runs this from the root of your repo and its exit code is the verdict).
#
# It runs the annotated tests next to this file against your licensing
# policy, docs/data/LICENSE_POLICY.md, and your allowlist,
# docs/data/license-allowlist.toml. Standard library only (tomllib), so uv
# supplies a Python >= 3.11 and pytest. Read them with `ol tests ethics.01`.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"

fail() { echo "ethics.01: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
for f in docs/data/LICENSE_POLICY.md docs/data/license-allowlist.toml; do
  [ -f "$PWD/$f" ] || fail "$f is missing: write it from the chapter's template (section 4)"
done

export OL_REPO="$PWD" PYTHONPATH="$tests" PYTHONDONTWRITEBYTECODE=1
exec uv run --no-project --python ">=3.11" --quiet --with pytest \
  python -m pytest -q -p no:cacheprovider --rootdir="$tests" --confcutdir="$tests" "$here"
