#!/usr/bin/env bash
# Artifact check for lang.01 (DESIGN 4.6 primers; H15: `ol check lang.01`
# runs this in your repo and its exit code is the verdict).
#
# It runs the annotated tests next to this file against primers/lang.01/ in
# YOUR repo, inside YOUR uv project primers/lang.01/pyproject.toml, so the
# numpy you declared is the numpy you are graded with. Read them with
# `ol tests lang.01`.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
dir="$PWD/primers/lang.01"

fail() { echo "lang.01: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
for f in worksheet.py bigram.py; do
  [ -f "$dir/$f" ] || fail "primers/lang.01/$f is missing: run \`ol start lang.01\`"
done
[ -f "$dir/pyproject.toml" ] || fail "primers/lang.01/pyproject.toml is missing: make the uv project (chapter, section 4, step 1)"

export OL_PRIMER_DIR="$dir" PYTHONPATH="$dir:$tests" PYTHONDONTWRITEBYTECODE=1
exec uv run --project "$dir" --quiet --with pytest \
  python -m pytest -q -p no:cacheprovider --rootdir="$tests" --confcutdir="$tests" "$here"
