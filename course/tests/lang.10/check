#!/usr/bin/env bash
# Artifact check for lang.10 (DESIGN 4.6 primers; H15: `ol check lang.10`
# runs this in your repo and its exit code is the verdict).
#
# It builds the Go module in primers/lang.10/go/ (a toy KvTransferService
# over the vendored stubs in contracts/go, and the `evolve` decoder) and the
# Rust package in primers/lang.10/rust/ (the `kvpush` client over
# contracts/rust/tl-proto), runs your own `go test` and `cargo test`, then
# starts your server and drives it with your client. Offline: every module
# and crate comes from the local caches. Read the tests with
# `ol tests lang.10`.
#
# The first run writes the starter files that are missing into
# primers/lang.10/: the manifests (go.mod, go.sum, Cargo.toml) as given, and
# every .go and .rs file with each function body replaced by a stub (the
# harness's own stubber), so the first run compiles and fails. It never
# overwrites a file.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"
dir="$PWD/primers/lang.10"

fail() { echo "lang.10: $*" >&2; exit 1; }
for tool in go cargo uv; do
  command -v "$tool" >/dev/null || fail "$tool is not on PATH (ol doctor)"
done
[ -f "$PWD/contracts/go/go.mod" ] || fail "contracts/go is missing: run from your course repo (ol course init vendors it)"

# -- starter files ---------------------------------------------------------
missing=()
for f in go/go.mod go/go.sum go/kvstore/kvstore.go go/kvstore/kvstore_test.go go/cmd/kvstore/main.go go/cmd/evolve/main.go \
         rust/Cargo.toml rust/src/lib.rs rust/src/main.rs; do
  [ -f "$dir/$f" ] || missing+=("$f")
done
if [ ${#missing[@]} -gt 0 ]; then
  uv run --no-project --quiet python - "$course" "$dir" "${missing[@]}" <<'PY' || fail "could not write the starter files"
import sys
from pathlib import Path
course, dest, names = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3:]
sys.path.insert(0, str(course / "harness" / "src"))
from olcourse import markers
for name in names:
    text = (course / "ref" / "primers" / "lang.10" / name).read_text()
    out = markers.stub(text, name, want="lang.10") if markers.has_markers(text) else text
    (dest / name).parent.mkdir(parents=True, exist_ok=True)
    (dest / name).write_text(out)
    print(f"  wrote     primers/lang.10/{name}" + ("  (stub: yours to write)" if out != text else "  (given)"))
PY
fi

# Build products stay out of your tree: .ol/ is gitignored by `ol course init`.
export OL_PRIMER_DIR="$dir" PYTHONDONTWRITEBYTECODE=1
export CARGO_TARGET_DIR="${OL_PRIMER_TARGET:-$PWD/.ol/build/lang.10/target}"
export OL_PRIMER_BIN="$PWD/.ol/build/lang.10/bin"
export GOPROXY=off GOWORK=off GOTOOLCHAIN=local GOFLAGS=-mod=mod
exec uv run --no-project --quiet --with pytest \
  python -m pytest -q --tb=short -p no:cacheprovider --rootdir="$tests" --confcutdir="$tests" "$here"
