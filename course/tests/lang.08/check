#!/usr/bin/env bash
# Artifact check for lang.08 (DESIGN 4.6 primers; H15: `ol check lang.08`
# runs this in your repo and its exit code is the verdict).
#
# It runs the annotated tests next to this file against
# primers/lang.08/downloader.py in YOUR repo. The exercise is standard
# library only, so no project is needed: uv supplies a Python >= 3.11 (for
# asyncio.TaskGroup and asyncio.timeout) and pytest. The tests talk only to
# servers they start on 127.0.0.1, among them the course's `flakyhttp`
# fixture server (course/testkit/python). Read them with `ol tests lang.08`.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
kit="$(cd "$tests/../testkit/python" && pwd)"
dir="$PWD/primers/lang.08"

fail() { echo "lang.08: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
[ -f "$dir/downloader.py" ] || fail "primers/lang.08/downloader.py is missing: run \`ol start lang.08\`"

export OL_PRIMER_DIR="$dir" PYTHONPATH="$dir:$tests:$kit" PYTHONDONTWRITEBYTECODE=1
exec uv run --no-project --python ">=3.11" --quiet --with pytest \
  python -m pytest -q -p no:cacheprovider --rootdir="$tests" --confcutdir="$tests" "$here"
