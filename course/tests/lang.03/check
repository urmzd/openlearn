#!/usr/bin/env bash
# Artifact check for lang.03 (DESIGN 4.6 primers; H15: `ol check lang.03`
# runs this in your repo and its exit code is the verdict).
#
#   primers/lang.03/vec.c with the given vec.h, compiled with
#   -std=c11 -pedantic -Werror under ASan and UBSan, against test_vec.c.
#
# The first run writes the starter files that are missing (the given
# header and stub for the file you write) into primers/lang.03/;
# it never overwrites a file. Read the tests with `ol tests lang.03`.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"
dir="$PWD/primers/lang.03"
inc="$PWD/contracts/c/include"
build="$PWD/.ol/build/lang.03"

fail() { echo "lang.03: $*" >&2; exit 1; }
for tool in cc uv; do
  command -v "$tool" >/dev/null || fail "$tool is not on PATH (ol doctor)"
done
[ -f "$inc/ol_test.h" ] || fail "contracts/c/include/ol_test.h is missing: run \`ol contracts sync\`"

# -- starter files ---------------------------------------------------------
# Given files are copied as they are; the files you write are copied with
# every solution region replaced by a stub that compiles (the harness's own
# stubber), so the first run compiles and fails.
missing=()
for f in vec.h vec.c; do
  [ -f "$dir/$f" ] || missing+=("$f")
done
if [ ${#missing[@]} -gt 0 ]; then
  mkdir -p "$dir"
  uv run --no-project --quiet python - "$course" "$dir" "${missing[@]}" <<'PY' || fail "could not write the starter files"
import sys
from pathlib import Path
course, dest, names = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3:]
sys.path.insert(0, str(course / "harness" / "src"))
from olcourse import markers
for name in names:
    src = course / "ref" / "primers" / "lang.03" / name
    text = src.read_text()
    out = markers.stub(text, name, want="lang.03") if markers.has_markers(text) else text
    (dest / name).write_text(out)
    print(f"  wrote     primers/lang.03/{name}" + ("  (stub: yours to write)" if out != text else "  (given)"))
PY
fi

mkdir -p "$build"
status=0

# -- 1. the dynamic array under sanitizers ---------------------------------
echo "lang.03: vec.c under -std=c11 -pedantic -Werror, ASan, UBSan"
san=(-std=c11 -pedantic -Wall -Wextra -Wno-unused-parameter -Werror -O1 -g
     -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
if cc "${san[@]}" -include "$here/count_alloc.h" -I"$dir" -c "$dir/vec.c" -o "$build/vec.o" &&
   cc "${san[@]}" -I"$dir" -I"$inc" -c "$here/test_vec.c" -o "$build/test_vec.o" &&
   cc "${san[@]}" "$build/vec.o" "$build/test_vec.o" -o "$build/test_vec"; then
  ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}" UBSAN_OPTIONS="halt_on_error=1:print_stacktrace=1" \
    "$build/test_vec"
  rc=$?
  if [ $rc -ne 0 ]; then
    status=1
    # 134 = 128 + SIGABRT: a sanitizer report, or a stub's abort() (the
    # starter vec.c aborts until you write it).
    [ $rc -eq 134 ] && echo "  test_vec aborted (signal 6): read the sanitizer report above, or replace the stub's abort()"
  fi
else
  echo "  does not compile (see above)"
  status=1
fi

exit $status
