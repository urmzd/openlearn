#!/usr/bin/env bash
# ol-export: course-tree (grades against the course's reference katas, never exported)
# Artifact check for craft.08 (DESIGN 4.6; H15: `ol check craft.08` runs this
# in your repo and its exit code is the verdict).
#
# Code review of a seeded pull request. The PR is built in a scratch clone of
# your repo (.ol/craft.08/pr) and fetched into your repo as branch
# drill/craft-08 (DESIGN 5.10 git-branch): its first commit replaces
# go/gateway/limit/limit.go with gw.03's course reference, the next two are
# a teammate's change with five seeded defects. Your working tree is never
# touched. You review it and record findings in
# docs/reviews/craft-08-pr-review.toml; the tests (`ol tests craft.08`) grade
# them against the hidden defect list, after proving each defect is a real
# bug with a Go test.
#
# The first run builds the branch and writes the review template (it never
# overwrites a file of yours), so it fails. Later runs rebuild the branch only
# when the course changed the PR. Needs git, patch, and go (Pass 7).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"

fail() { echo "craft.08: $*" >&2; exit 1; }
for t in uv git patch go; do command -v "$t" >/dev/null || fail "$t is not on PATH (ol doctor)"; done
[ -f "$course/mutants/craft.08/pr.toml" ] ||
  fail "the course tree at $course has no craft.08 pull request: this check runs inside a openlearn checkout (OL_COURSE_TREE)"
git rev-parse --git-dir >/dev/null 2>&1 || fail "$PWD is not a git repository (ol course init makes one)"
[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" != "drill/craft-08" ] ||
  fail "you are on drill/craft-08: check out your own branch first (git switch -), then rerun"

export OL_COURSE_TREE="$course" OL_LEARNER_ROOT="$PWD" PYTHONDONTWRITEBYTECODE=1
uv run --no-project --quiet python - <<'PY' || fail "could not build the pull request branch"
import os, sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.environ["OL_COURSE_TREE"], "tests", "craft.08"))
import _pr

learner = Path(os.environ["OL_LEARNER_ROOT"])
state, msg = _pr.ensure_branch(learner)
if state == "error":
    sys.exit(f"craft.08: {msg}")
pr = _pr.build()
br = _pr.branch(pr)
if state != "current":
    print(f"  {state:<9} {msg}")
    print(f"            review it:  git log --stat {br}~2..{br}  and  git diff {br}~2 {br}")
if _pr.write_template(learner):
    print(f"  wrote     {pr.spec['review']}  (empty: yours to fill)")
PY

exec uv run --no-project --quiet --with pytest \
  python -m pytest -q --tb=short -p no:cacheprovider -p no:randomly --rootdir="$here" --confcutdir="$here" \
  "$here/test_craft08_review.py"
