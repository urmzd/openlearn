#!/usr/bin/env bash
# ol-export: course-tree (grades against the course's reference katas, never exported)
# Artifact check for craft.22 (DESIGN 4.6, 5.12 rung R8; `ol check craft.22`
# runs this in your repo and its exit code is the verdict).
#
# It grades YOUR model evals in primers/craft.22/: evals.py (the eval
# library, the kata), test_model_evals.py (your suite), and baseline.json
# (the good model measured with your evals). Your suite must pass on the
# course's tiny model, pass on two harmless variants of it, and fail on the
# model mutants in course/mutants/craft.22 (a wrong RoPE base, a dropped
# layer, a tokenizer one merge short, a decoding bug, ...): at least 0.80 of
# them and always s01 to s03, each flagged at p < 0.05 over five seeds.
# Read the tests with `ol tests craft.22`.
#
# The first run writes primers/craft.22/tinymodel.py (the course's model,
# yours to read and run, never to edit: the check always uses the course's
# copy) and primers/craft.22/evals.py when missing, with every function
# body replaced by a stub. It never overwrites a file. Each pytest run is
# its own process group with a timeout.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"
dir="$PWD/primers/craft.22"

fail() { echo "craft.22: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
[ -f "$course/ref/primers/craft.22/tinymodel.py" ] ||
  fail "the course tree at $course has no craft.22 model: this check runs inside a openlearn checkout (OL_COURSE_TREE)"

mkdir -p "$dir"
uv run --no-project --quiet python - "$course" "$dir" <<'PY' || fail "could not write the starter files"
import sys
from pathlib import Path
course, dest = Path(sys.argv[1]), Path(sys.argv[2])
sys.path.insert(0, str(course / "harness" / "src"))
from olcourse import markers
ref = course / "ref" / "primers" / "craft.22"
if not (dest / "tinymodel.py").exists():
    (dest / "tinymodel.py").write_text((ref / "tinymodel.py").read_text())
    print("  wrote     primers/craft.22/tinymodel.py  (the course's model: read it, do not edit it)")
if not (dest / "evals.py").exists():
    (dest / "evals.py").write_text(markers.stub((ref / "evals.py").read_text(), "primers/craft.22/evals.py", want="craft.22"))
    print("  wrote     primers/craft.22/evals.py  (stub: yours to write)")
PY

export OL_PRIMER_DIR="$dir" OL_COURSE_TREE="$course" OL_LEARNER_ROOT="$PWD" PYTHONDONTWRITEBYTECODE=1
export TINYLLM_FIXTURES="${TINYLLM_FIXTURES:-$course/fixtures}"
exec uv run --no-project --quiet --with pytest --with numpy \
  python -m pytest -q --tb=short -p no:cacheprovider -p no:randomly --rootdir="$tests" --confcutdir="$tests" "$here"
