#!/usr/bin/env bash
# Artifact check for lang.04 (DESIGN 4.6 primers; H15: `ol check lang.04`
# runs this in your repo and its exit code is the verdict).
#
# It builds the Cargo workspace in primers/lang.04/ of YOUR repo, runs your
# own `cargo test`, then starts your `echo` server on a free port and talks
# the line protocol to it over TCP. Read the tests with `ol tests lang.04`.
#
# The first run writes the starter files that are missing into
# primers/lang.04/: the Cargo manifests as given, and every .rs file with each
# function body replaced by `todo!("lang.04")` (the harness's own stubber), so
# the first run compiles and fails. It never overwrites a file.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"
dir="$PWD/primers/lang.04"

fail() { echo "lang.04: $*" >&2; exit 1; }
for tool in cargo uv; do
  command -v "$tool" >/dev/null || fail "$tool is not on PATH (ol doctor)"
done

# -- starter files ---------------------------------------------------------
missing=()
for f in Cargo.toml lineproto/Cargo.toml lineproto/src/lib.rs echo/Cargo.toml echo/src/main.rs; do
  [ -f "$dir/$f" ] || missing+=("$f")
done
if [ ${#missing[@]} -gt 0 ]; then
  uv run --no-project --quiet python - "$course" "$dir" "${missing[@]}" <<'PY' || fail "could not write the starter files"
import sys
from pathlib import Path
course, dest, names = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3:]
sys.path.insert(0, str(course / "harness" / "src"))
from olcourse import markers
for name in names:
    text = (course / "ref" / "primers" / "lang.04" / name).read_text()
    out = markers.stub(text, name, want="lang.04") if markers.has_markers(text) else text
    (dest / name).parent.mkdir(parents=True, exist_ok=True)
    (dest / name).write_text(out)
    print(f"  wrote     primers/lang.04/{name}" + ("  (stub: yours to write)" if out != text else "  (given)"))
PY
fi

# Build products stay out of your tree: .ol/ is gitignored by `ol course init`.
export OL_PRIMER_DIR="$dir" PYTHONDONTWRITEBYTECODE=1
export CARGO_TARGET_DIR="${OL_PRIMER_TARGET:-$PWD/.ol/build/lang.04/target}"
exec uv run --no-project --quiet --with pytest \
  python -m pytest -q --tb=short -p no:cacheprovider --rootdir="$tests" --confcutdir="$tests" "$here"
