{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C1 capstone report (docs/capstone/c1/report.json)",
  "description": "What your capstone run measured: the model, the training run, held-out bits per byte with a 95% CI, the three core ablations (each a paired comparison with a CI), the scaling-law fit, and where the zoo table, the samples, and the release spec are. Written by your capstone tooling from the run's own outputs; `ol check C1` recomputes what can be recomputed (parameter counts, KV bytes, active parameters, the fit) and checks the rest for consistency. Course-side schema for now (DEVIATIONS B112-07).",
  "type": "object",
  "required": ["format", "tier", "spec", "tokenizer", "model", "train", "eval", "ablations", "scaling", "zoo", "samples", "release"],
  "properties": {
    "format": {"const": "tl.capstone-report.v1"},
    "tier": {"enum": ["full", "short", "smoke"], "description": "full: the about-10M config; short: the about-2.5M config; smoke: the milestone's --smoke config (accepted only under OL_SMOKE=1)."},
    "spec": {"type": "string", "description": "The train spec of the main run, a path in your repo (specs/c1/...)."},
    "data": {"type": "object"},
    "tokenizer": {
      "type": "object", "required": ["kind", "vocab_size"],
      "properties": {"kind": {"enum": ["bpe", "unigram"]}, "vocab_size": {"type": "integer", "minimum": 2}, "sample_bytes": {"type": "integer", "minimum": 0}}
    },
    "model": {
      "type": "object", "required": ["config", "params"],
      "properties": {"config": {"type": "object", "required": ["tl_arch", "vocab_size", "hidden_size", "intermediate_size", "num_hidden_layers", "num_attention_heads"]}, "params": {"type": "integer", "minimum": 1}}
    },
    "train": {
      "type": "object", "required": ["steps", "tokens", "seed", "precision"],
      "properties": {"steps": {"type": "integer", "minimum": 1}, "tokens": {"type": "integer", "minimum": 1}, "seed": {"type": "integer", "minimum": 0},
                     "precision": {"enum": ["fp32", "bf16", "fp16"]}, "micro_batch": {"type": "integer"}, "accum": {"type": "integer"}}
    },
    "eval": {
      "type": "object", "required": ["val_bpb", "ci95", "n"],
      "properties": {"val_bpb": {"type": "number", "exclusiveMinimum": 0}, "ci95": {"$ref": "#/$defs/ci"}, "n": {"type": "integer", "minimum": 1}, "val_loss": {"type": "number"}}
    },
    "ablations": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/ablation"}},
    "scaling": {
      "type": "object", "required": ["points", "fit"],
      "properties": {
        "law": {"type": "string"},
        "points": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["params", "bpb"], "properties": {"params": {"type": "integer", "minimum": 1}, "bpb": {"type": "number", "exclusiveMinimum": 0}}}},
        "fit": {"type": "object", "required": ["a", "alpha"], "properties": {"a": {"type": "number"}, "alpha": {"type": "number"}}}
      }
    },
    "long_context": {"type": ["object", "null"]},
    "zoo": {"type": "string"},
    "samples": {"type": "string"},
    "release": {"type": "string"}
  },
  "$defs": {
    "ci": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "arm": {"type": "object", "required": ["name", "config", "value"], "properties": {"name": {"type": "string"}, "config": {"type": "object"}, "value": {"type": "number"}}},
    "ablation": {
      "type": "object", "required": ["id", "metric", "n", "a", "b", "mean_diff", "ci95", "winner"],
      "properties": {
        "id": {"enum": ["tokenizer", "attention", "mlp"]},
        "question": {"type": "string"},
        "metric": {"const": "bpb"},
        "unit": {"type": "string"},
        "n": {"type": "integer", "minimum": 2},
        "seed": {"type": "integer"},
        "a": {"$ref": "#/$defs/arm"},
        "b": {"$ref": "#/$defs/arm"},
        "mean_diff": {"type": "number", "description": "mean over paired units of bpb(b) - bpb(a)"},
        "ci95": {"$ref": "#/$defs/ci"},
        "winner": {"enum": ["a", "b", "tie"]},
        "kv_bytes_per_token": {"type": "object", "required": ["a", "b"]},
        "active_params": {"type": "object", "required": ["a", "b"]}
      }
    }
  }
}
