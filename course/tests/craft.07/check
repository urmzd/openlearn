#!/usr/bin/env bash
# ol-export: course-tree (grades against the course's reference katas, never exported)
# Artifact check for craft.07 (DESIGN 4.6; H15: `ol check craft.07` runs this
# in your repo and its exit code is the verdict).
#
# It grades three artifacts in primers/craft.07/ against the course's L4.5
# reference, tinyllm/eval/seqmetrics.py (read the tests with `ol tests
# craft.07`):
#   test_seqmetrics.py  your deepened L4.5 suite: it must accept the
#                       reference and your own L4.5, and kill EVERY L4.5
#                       mutant (course/mutants/L4.5), not 80% of them
#   triage.toml         your verdict on each of the ten survivors in
#                       primers/craft.07/survivors/: equivalent or
#                       killable; a killable one names the test of yours
#                       that now kills it, alone
#   mutants/*.patch     at least two semantic mutants you wrote from L4.5's
#                       pitfalls: each a real bug (the course's L4.5 tests
#                       kill it), new (no committed mutant gives the same
#                       file), and killed by your suite
#
# The first run writes primers/craft.07/survivors/ (the ten diffs and a
# README) and a triage.toml with empty verdicts when they are missing, so
# the first run fails. It never overwrites a file of yours. Each pytest run
# is its own process group with a timeout; your tree is never touched.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"
dir="$PWD/primers/craft.07"

fail() { echo "craft.07: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
[ -f "$course/ref/python/tinyllm/eval/seqmetrics.py" ] ||
  fail "the course tree at $course has no L4.5 reference: this check runs inside a openlearn checkout (OL_COURSE_TREE)"

mkdir -p "$dir"
uv run --no-project --quiet python - "$course" "$dir" <<'PY' || fail "could not write the survivors"
import sys
from pathlib import Path

course, dest = Path(sys.argv[1]), Path(sys.argv[2])
man = course / "mutants" / "craft.07" / "manifest.tsv"
rows = [l.split("\t") for l in man.read_text().splitlines() if l.strip() and not l.startswith("#")]
surv = dest / "survivors"
if not surv.is_dir():
    surv.mkdir(parents=True)
    lines = [
        "# Ten mutants of tinyllm/eval/seqmetrics.py that a rung R5 suite let live",
        "",
        "Each `sNN.diff` is one mutant against the course's L4.5 reference. Decide for",
        "each whether it is **equivalent** (no input tells it from the reference) or",
        "**killable** (a real bug your tests missed), and record it in ../triage.toml.",
        "",
        "| id | what changed |",
        "|---|---|",
    ]
    for r in rows:
        (surv / f"{r[0]}.diff").write_text((course / "mutants" / "craft.07" / f"{r[0]}.patch").read_text())
        lines.append(f"| {r[0]} | {r[6]} |")
    (surv / "README.md").write_text("\n".join(lines) + "\n")
    print("  wrote     primers/craft.07/survivors/  (the ten survivors to triage)")
triage = dest / "triage.toml"
if not triage.exists():
    body = ["# Your verdicts (chapter section 4): equivalent or killable, a reason, and for a",
            "# killable survivor the name of the test in test_seqmetrics.py that kills it.", ""]
    for r in rows:
        body += [f"[{r[0]}]  # {r[6]}", 'verdict = ""', 'reason  = ""', 'test    = ""', ""]
    triage.write_text("\n".join(body))
    print("  wrote     primers/craft.07/triage.toml  (empty verdicts: yours to fill)")
PY

export OL_PRIMER_DIR="$dir" OL_COURSE_TREE="$course" OL_LEARNER_ROOT="$PWD" PYTHONDONTWRITEBYTECODE=1
exec uv run --no-project --quiet --with pytest --with numpy \
  python -m pytest -q --tb=short -p no:cacheprovider -p no:randomly --rootdir="$tests" --confcutdir="$tests" "$here"
