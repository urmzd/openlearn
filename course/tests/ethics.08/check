#!/usr/bin/env bash
# ol-export: course-tree
# Grade the learner's consent records and runnable evidence generator.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
for f in primers/ethics.08/evidence.py docs/data/CONSENT_POLICY.md docs/data/mm-ledger.jsonl docs/models/multimodal.md evals/asr-recorded/predictions.json evals/asr-recorded/summary.json; do
  [ -f "$PWD/$f" ] || { echo "ethics.08: missing $f" >&2; exit 1; }
done
export OL_REPO="$PWD" PYTHONPATH="$PWD/python:$tests" PYTHONDONTWRITEBYTECODE=1
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
exec uv run --no-project --python '>=3.11' --quiet --with pytest --with numpy --with pillow --with pyarrow --with zstandard \
  python -m pytest -q -p no:cacheprovider --rootdir="$tests" --confcutdir="$tests" "$here"
