#!/usr/bin/env bash
# ol-export: course-tree (grades against the course's reference katas, never exported)
# Artifact check for craft.05 (DESIGN 4.6; H15: `ol check craft.05` runs
# this in your repo and its exit code is the verdict).
#
# It grades YOUR oracle tests in primers/craft.05/test_oracles.py (read them
# with `ol tests craft.05`): they pass against your kata
# primers/craft.05/kernels.py, they pass against the course's kata, and they
# fail against the ten planted faults in course/mutants/craft.05 (the
# chapter's pitfalls: transposed gradients, a softmax backward without its
# row sum, a lost scale, an unstable softmax, ...). Rung R5: at least 0.80
# of the faults, and the transposed weight gradient (s01) always.
# Your kata itself is also compared with torch's values and gradients in
# course/fixtures/craft.05/oracles.npz.
#
# The first run writes primers/craft.05/kernels.py when it is missing, with
# every function body replaced by a stub (the harness's own stubber), so the
# first run fails. It never overwrites a file; test_oracles.py is yours. Each
# pytest run is its own process group with a timeout.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tests="$(cd "$here/.." && pwd)"
course="${OL_COURSE_TREE:-$(cd "$here/../.." && pwd)}"
dir="$PWD/primers/craft.05"

fail() { echo "craft.05: $*" >&2; exit 1; }
command -v uv >/dev/null || fail "uv is not on PATH (ol doctor)"
[ -f "$course/ref/primers/craft.05/kernels.py" ] ||
  fail "the course tree at $course has no craft.05 kata: this check runs inside a openlearn checkout (OL_COURSE_TREE)"

if [ ! -f "$dir/kernels.py" ]; then
  mkdir -p "$dir"
  uv run --no-project --quiet python - "$course" "$dir" <<'PY' || fail "could not write the starter kata"
import sys
from pathlib import Path
course, dest = Path(sys.argv[1]), Path(sys.argv[2])
sys.path.insert(0, str(course / "harness" / "src"))
from olcourse import markers
text = (course / "ref" / "primers" / "craft.05" / "kernels.py").read_text()
(dest / "kernels.py").write_text(markers.stub(text, "primers/craft.05/kernels.py", want="craft.05"))
print("  wrote     primers/craft.05/kernels.py  (stub: yours to write)")
PY
fi

export OL_PRIMER_DIR="$dir" OL_COURSE_TREE="$course" OL_LEARNER_ROOT="$PWD" PYTHONDONTWRITEBYTECODE=1
export TINYLLM_FIXTURES="${TINYLLM_FIXTURES:-$course/fixtures}"
exec uv run --no-project --quiet --with pytest --with numpy \
  python -m pytest -q --tb=short -p no:cacheprovider -p no:randomly --rootdir="$tests" --confcutdir="$tests" "$here"
