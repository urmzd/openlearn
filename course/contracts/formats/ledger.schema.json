{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEDGER.jsonl row",
  "description": "One line of corpus/LEDGER.jsonl: one fetched source, its license, and what the pipeline kept (DESIGN 2.9; data.01 appends, data.08 verifies). ModelRelease (dur.12) refuses a model trained on a source whose allowed_uses lacks train. The license allowlist is data.08's; an unknown SPDX id fails verification with exit 65.",
  "type": "object",
  "required": [
    "source_id",
    "url",
    "license_spdx",
    "retrieved_at",
    "sha256",
    "n_docs",
    "allowed_uses",
    "pii_policy",
    "filters_applied",
    "kept",
    "dropped",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "license_spdx": {
      "type": "string",
      "minLength": 1,
      "description": "An SPDX license identifier or expression, for example CDLA-Sharing-1.0 or CC-BY-4.0."
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Of the fetched bytes."
    },
    "n_docs": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_uses": {
      "type": "array",
      "items": {
        "enum": [
          "train",
          "eval"
        ]
      }
    },
    "pii_policy": {
      "enum": [
        "scrub",
        "drop",
        "none"
      ],
      "description": "scrub: placeholders (data.05); drop: remove documents with PII; none: the source is known PII-free."
    },
    "filters_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kept": {
      "type": "integer",
      "minimum": 0
    },
    "dropped": {
      "type": "integer",
      "minimum": 0
    },
    "revoked": {
      "type": "boolean",
      "default": false,
      "description": "Set by the data-incident drill (ops.08): every derived shard must be purged."
    },
    "notes": {
      "type": "string"
    },
    "modality": {
      "enum": [
        "text",
        "image",
        "audio"
      ]
    },
    "biometric": {
      "type": "boolean"
    },
    "consent": {
      "enum": [
        "none",
        "public-domain",
        "cc-licensed",
        "explicit-donation"
      ]
    },
    "attribution": {
      "type": "string"
    },
    "prohibited_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "source_id": "tinystories",
      "url": "https://huggingface.co/datasets/roneneldan/TinyStories",
      "license_spdx": "CDLA-Sharing-1.0",
      "retrieved_at": "2026-10-09T12:00:00Z",
      "sha256": "6666666666666666666666666666666666666666666666666666666666666666",
      "n_docs": 2119719,
      "allowed_uses": [
        "train",
        "eval"
      ],
      "pii_policy": "scrub",
      "filters_applied": [
        "lang",
        "gopher",
        "repetition"
      ],
      "kept": 2088000,
      "dropped": 31719,
      "notes": ""
    }
  ]
}
