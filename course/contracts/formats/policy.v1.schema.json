{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "chapter: content/tracks/responsible-ai/05-usage-policy/01-usage-policy-at-the-gateway.md\nchapter: content/tracks/ai-platform-engineering/12-gateway/08-usage-policy-enforcement.md",
  "title": "usage policy v1 (gateway/policy.v1.yaml)",
  "description": "The gateway's usage policy (gw.08, ethics.05), as the JSON value of the parsed YAML. Rules are tried in order and the first whose match holds decides; when none holds, default_action decides. A rule matches when every condition it states holds: model and tenant are exact names (a list means any of them); max_tokens holds when the request's token limit exceeds it; classifier holds when softmax(W e + b)[class] >= threshold for the linear head over the engine's /v1/embeddings of the request's text (D33). A classifier rule whose embeddings call fails denies with 503 (fail closed). Every deny is audit-logged with the rule id and answered 451 usage_policy.",
  "type": "object",
  "required": [
    "version",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "default_action": {
      "enum": [
        "allow",
        "deny"
      ],
      "default": "allow"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "match",
          "action",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "tenant": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "max_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "classifier": {
            "type": "object",
            "required": [
              "head"
            ],
            "additionalProperties": false,
            "properties": {
              "head": {
                "type": "string",
                "description": "A linear head file under /artifacts (formats/linear-head.schema.json)."
              },
              "class": {
                "type": "string",
                "description": "The class whose probability is compared; default: the head's last class."
              },
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Default: the head's threshold."
              }
            }
          },
          "action": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Shown in the 451 message and the audit log."
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "default_action": "allow",
      "rules": [
        {
          "id": "cap-free-tier",
          "match": {
            "tenant": [
              "free"
            ],
            "max_tokens": 1024
          },
          "action": "deny",
          "reason": "free tier: max_tokens above 1024"
        },
        {
          "id": "unsafe-prompt",
          "match": {},
          "classifier": {
            "head": "models/smol-135m/v3/heads/usage.json",
            "class": "unsafe",
            "threshold": 0.9
          },
          "action": "deny",
          "reason": "usage policy: unsafe request"
        }
      ]
    }
  ]
}
