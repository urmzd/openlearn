+// sweep drops every key that has no open reservation, has been idle for at
+// least IdleTTL, and whose buckets have refilled to capacity: dropping it
+// then changes nothing a later request can observe. The caller holds l.mu.
+func (l *Limiter) sweep(now time.Time) {
+	for k, st := range l.keys {
+		if st.open > 0 || now.Sub(st.seen) < IdleTTL {
+			continue
+		}
+		st.req.refill(now)
+		st.tok.refill(now)
+		if st.req.level < st.req.capacity || st.tok.level < st.tok.capacity {
+			continue // in debt or still refilling: dropping it would forgive that
+		}
+		delete(l.keys, k)
+	}
+}
+
+// Len is the number of keys the limiter holds (the size sweep bounds).
+func (l *Limiter) Len() int {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return len(l.keys)
