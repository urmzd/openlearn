+// IdleTTL is how long a key may go without a Reserve before sweep may drop
+// its buckets. A dropped key comes back full on its next request, so sweep
+// drops only keys whose buckets have refilled to capacity by then.
+const IdleTTL = 2 * time.Minute
+
+// sweepEvery is the sweep cadence: a sweep walks every key under the lock,
+// so it runs once per sweepEvery Reserve calls, not on each one.
