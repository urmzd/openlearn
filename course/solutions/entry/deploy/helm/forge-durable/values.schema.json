{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "values.yaml of the durable chart",
  "description": "<system>-durable (dep.06, dur.*). A StatefulSet with a WAL PVC; 3 replicas only with Raft (dur.10). Policy checked by dep.03, dep.06, dep.07 over `helm template`: probes, resource requests and limits, non-root, no image tag latest, a PodDisruptionBudget, and secrets only through Secret references (this schema rejects literal secret values). Copy this file into the chart as values.schema.json; Helm then validates every install. Draft-07, because that is what Helm validates.",
  "type": "object",
  "required": [
    "image",
    "resources",
    "securityContext",
    "probes",
    "pdb",
    "replicaCount",
    "persistence",
    "walMaxBytes"
  ],
  "properties": {
    "image": {
      "$ref": "#/definitions/image"
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "securityContext": {
      "$ref": "#/definitions/securityContext"
    },
    "probes": {
      "$ref": "#/definitions/probes"
    },
    "pdb": {
      "$ref": "#/definitions/pdb"
    },
    "env": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/envVar"
      }
    },
    "artifacts": {
      "$ref": "#/definitions/artifacts"
    },
    "otel": {
      "$ref": "#/definitions/otel"
    },
    "runtime": {
      "$ref": "#/definitions/runtime"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "podAnnotations": {
      "type": "object"
    },
    "replicaCount": {
      "enum": [
        1,
        3
      ]
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": true
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "walMaxBytes": {
      "type": "integer",
      "minimum": 1,
      "description": "Rendered as [durable].wal_max_bytes; required so the disk quota is explicit (ops.11)."
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "NodePort",
            "ClusterIP"
          ]
        },
        "grpcPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 7233
        },
        "nodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767,
          "default": 30733
        },
        "raftPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 7234
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 9464
        }
      }
    },
    "testClock": {
      "const": false,
      "description": "--test-clock is for local tests only, never in a cluster."
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "not": {
            "enum": [
              "latest",
              ""
            ]
          },
          "description": "Never latest (dep.03 policy)."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "quantity": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti|k|M|G|T)?$"
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "$ref": "#/definitions/quantity"
            },
            "memory": {
              "$ref": "#/definitions/quantity"
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "required": [
        "runAsNonRoot",
        "runAsUser",
        "allowPrivilegeEscalation"
      ],
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": {
          "const": true
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "allowPrivilegeEscalation": {
          "const": false
        }
      }
    },
    "pdb": {
      "type": "object",
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": true
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            }
          ]
        }
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "probes": {
      "type": "object",
      "required": [
        "liveness",
        "readiness"
      ],
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "startup": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "secretRef": {
      "type": "object",
      "required": [
        "name",
        "key"
      ],
      "additionalProperties": false,
      "description": "A reference to a key of a Kubernetes Secret. Literal secret values are never accepted.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "envVar": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        },
        "valueFrom": {
          "type": "object",
          "required": [
            "secretKeyRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretKeyRef": {
              "$ref": "#/definitions/secretRef"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "valueFrom"
          ]
        },
        {
          "properties": {
            "name": {
              "not": {
                "pattern": "(?i)(KEY|SECRET|PEPPER|TOKEN|PASSWORD|CREDENTIAL)"
              }
            }
          }
        }
      ],
      "description": "A variable whose name looks secret (KEY, SECRET, PEPPER, TOKEN, PASSWORD, CREDENTIAL) must come from a Secret."
    },
    "artifacts": {
      "type": "object",
      "required": [
        "hostPath"
      ],
      "additionalProperties": false,
      "properties": {
        "hostPath": {
          "type": "string",
          "pattern": "^/",
          "default": "/artifacts"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/",
          "default": "/artifacts"
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "description": "The runtime.toml content as a map, rendered into the ConfigMap with toToml; validated by contracts/config/runtime.schema.json at test time."
    }
  }
}
