{
 "name": "c1-smoke",
 "model": {
  "tl_arch": "llama",
  "tl_tokenizer": "file",
  "vocab_size": 512,
  "hidden_size": 128,
  "intermediate_size": 344,
  "num_hidden_layers": 4,
  "num_attention_heads": 4,
  "num_key_value_heads": 2,
  "max_position_embeddings": 128,
  "rms_norm_eps": 1e-05,
  "rope_theta": 10000.0,
  "tie_word_embeddings": true,
  "tl_format": 1
 },
 "tokenizer": {
  "id": "c1-bpe-512",
  "path": "tokenizers/c1-bpe-512/tokenizer.json"
 },
 "data": {
  "train": [
   "tokens/c1-bpe-512/stories/_MANIFEST.json"
  ],
  "val": [
   "tokens/c1-bpe-512/stories-val.bin"
  ]
 },
 "optimizer": {
  "name": "adamw",
  "lr": 0.003,
  "betas": [
   0.9,
   0.95
  ],
  "weight_decay": 0.1
 },
 "schedule": {
  "name": "wsd",
  "warmup_steps": 20,
  "decay_frac": 0.2,
  "min_lr_ratio": 0.1
 },
 "precision": {
  "dtype": "fp32"
 },
 "batch": {
  "micro_batch": 16,
  "accum": 1,
  "seq_len": 128
 },
 "steps": 200,
 "ckpt_every": 100,
 "seed": 0
}
