#!/usr/bin/env bash
# craft.01 reference commit-msg hook: accept only a Conventional Commits header.
#
#   .githooks/commit-msg <file holding the message>      (git passes the file)
#
# Install once per clone: git config core.hooksPath .githooks
# CI runs the same file over every pushed commit, so a commit made without
# the hook (or with --no-verify) still cannot reach the default branch green.
set -euo pipefail
msg_file="${1:?usage: commit-msg <message file>}"

# The header is the first line that is neither a comment (git strips lines
# starting with '#') nor blank.
header="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1 || true)"

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([^()[:space:]]+\))?!?: [^[:space:]].*$"
if [[ "$header" =~ $pattern ]]; then
  exit 0
fi
{
  echo "commit-msg: not a Conventional Commits header: '$header'"
  echo "  want: <type>[(scope)][!]: <description>"
  echo "  type: ${types//|/ }"
  echo "  e.g.: feat(make): rebuild objects when greet.h changes"
} >&2
exit 1
