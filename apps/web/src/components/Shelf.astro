---
import library from '../generated/library.json';
---
<div class="shelf">
  <p class="library-intro">Books on computing, mathematics, and engineering. Open a book and read from the foundations to the code.</p>
  <label class="book-filter" for="book-filter">Find a book
    <input id="book-filter" type="search" placeholder="Title or subject…" autocomplete="off" aria-controls="book-list" />
  </label>
  <p class="filter-count" id="filter-count" role="status" aria-live="polite">{library.courses.length} books</p>
  <a class="continue-card" id="continue-card" hidden>
    <span>Continue reading</span>
    <strong id="continue-title"></strong>
    <span id="continue-book" class="continue-book"></span>
  </a>
  <ol class="book-list" id="book-list">
    {library.courses.map((course) => (
      <li class="book" data-course={course.id}>
        <a class="book-link" href={course.href}>
          <span class="book-title">{course.title}</span>
          <span class="book-description">{course.description}</span>
        </a>
        <div class="book-meta">
          <span>{course.lessons.length} sections</span>
          <a href={course.href} aria-label={`Read ${course.title}`}>Read book</a>
          {course.pdf && <a href={course.pdf} aria-label={`Download ${course.title} PDF`}>PDF</a>}
        </div>
      </li>
    ))}
  </ol>
  <p id="no-books" hidden>No books match your search. Try a broader subject.</p>
</div>
