---
import library from '../generated/library.json';
---
<div class="shelf">
  <a class="continue-card" id="continue-card" hidden>
    <span class="eyebrow">Continue reading</span>
    <strong id="continue-title"></strong>
    <span id="continue-book" class="continue-book"></span>
  </a>
  <ol class="book-list" id="book-list">
    {library.courses.map((course) => (
      <li class="book" data-course={course.id}>
        <a class="book-link" href={course.href}>
          <span class="book-title">{course.title}</span>
          <span class="book-description">{course.description}</span>
        </a>
        <div class="book-meta">
          <span data-course-progress={course.id}>{course.lessons.length} sections</span>
          <progress data-meter={course.id} max={course.lessons.length} value="0" hidden aria-label={`${course.title} reading progress`}></progress>
          <button type="button" class="quiet-button" data-download={course.id}>Save offline</button>
        </div>
      </li>
    ))}
  </ol>
  <section class="shelf-notes" id="shelf-notes" hidden aria-labelledby="notes-title">
    <h2 id="notes-title">Your notes</h2>
    <ul id="saved-notes"></ul>
  </section>
  <details class="shelf-settings">
    <summary>Your progress on this device</summary>
    <p>Reading progress and notes stay in this browser. Export a copy to move them to another device.</p>
    <div class="backup-actions">
      <button type="button" class="quiet-button" id="export-progress">Export progress</button>
      <label class="quiet-button import-control" for="import-progress">Import progress<input id="import-progress" type="file" accept="application/json,.json" /></label>
    </div>
    <p id="storage-usage"></p>
  </details>
</div>
<noscript><p>Enable JavaScript to track reading progress and save books offline. Every book and its PDF work without it.</p></noscript>
