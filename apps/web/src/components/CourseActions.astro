---
import library from '../generated/library.json';
const course = library.courses.find((c) => c.id === Astro.props.id);
---
{course && <section class="course-offline" data-course={course.id} aria-label="Your course">
  <p><span data-course-progress={course.id}>Choose where to begin</span> · {course.lessons.length} readings</p>
  <button type="button" data-download={course.id}>Save offline</button>
  <span class="download-state" data-download-state={course.id} aria-live="polite"></span>
</section>}
