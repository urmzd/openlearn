---
import library from '../generated/library.json';
const course = library.courses.find((c) => c.id === Astro.props.id);
---
{course && <section class="course-offline" data-course={course.id} aria-label="This book">
  <p><span data-course-progress={course.id}>{course.lessons.length} sections</span></p>
  <a class="primary" data-begin={course.id} href={course.lessons[0]?.url}>Start reading</a>
  <button type="button" class="quiet-button" data-download={course.id}>Save offline</button>
  <span class="download-state" data-download-state={course.id} aria-live="polite"></span>
</section>}
