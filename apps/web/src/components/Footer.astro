---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---
<DefaultFooter />
<nav class="app-dock" aria-label="Learning app">
  <a href="/" data-app-nav="library"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5c3-1 6 0 9 2 3-2 6-3 9-2v15c-3-1-6 0-9 2-3-2-6-3-9-2Zm9 2v15"/></svg><span>Library</span></a>
  <a href="/my-learning/" data-app-nav="learning"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L20 5M4 21h16"/></svg><span>My learning</span></a>
  <button type="button" id="install-app"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg><span>Install app</span></button>
  <span class="connection-state" id="connection-state" role="status">Ready to learn</span>
</nav>
<div class="app-message" id="app-message" role="status" aria-live="polite" hidden></div>
<div class="update-banner" id="update-banner" hidden><span>A new edition is ready.</span><button type="button" id="update-app">Update app</button><button type="button" id="dismiss-update" aria-label="Dismiss update notification">Later</button></div>
<dialog id="note-dialog" class="learning-dialog" aria-labelledby="note-title">
  <form id="note-form">
    <h2 id="note-title">Your note</h2>
    <label for="lesson-note">What would you like to remember?</label>
    <textarea id="lesson-note" name="note" rows="9" maxlength="20000"></textarea>
    <p>Notes stay on this device. Export a backup from My learning to keep a copy.</p>
    <div class="dialog-actions"><button type="button" data-close-dialog>Cancel</button><button type="submit" class="primary">Save note</button></div>
  </form>
</dialog>
<dialog id="install-dialog" class="learning-dialog" aria-labelledby="install-title">
  <h2 id="install-title">Keep learning close</h2>
  <p>Install OpenLearn to open it from your home screen or dock. Save individual courses for offline reading from the library.</p>
  <p id="install-instructions">Use your browser’s Install app option. In Safari on iPhone or iPad, open Share and choose Add to Home Screen. On Mac, use File, then Add to Dock.</p>
  <div class="dialog-actions"><button type="button" data-close-dialog>Close</button></div>
</dialog>
