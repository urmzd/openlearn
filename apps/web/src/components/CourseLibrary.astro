---
import library from '../generated/library.json';
---
<section class="library-intro">
  <p class="library-lead">Find something you want to understand. Build on it at your own pace.</p>
  <a href="/my-learning/" class="continue-link" id="library-resume" hidden>Continue learning</a>
</section>
<div class="library-filters">
  <label class="course-search">Find a course<input id="course-filter" type="search" placeholder="Try mathematics, systems, or design" autocomplete="off" /></label>
  <button type="button" id="offline-filter" aria-pressed="false">Saved offline</button>
</div>
<p id="course-count" class="course-count" aria-live="polite">{library.courses.length} courses</p>
<div class="course-library" id="course-library">
  {library.courses.map((course) => (
    <article class="course-row" data-course={course.id} data-search={`${course.title} ${course.description}`.toLowerCase()}>
      <div class="course-description">
        <h2><a href={course.href}>{course.title}</a></h2>
        <p>{course.description}</p>
        <p class="course-meta"><span>{course.lessons.length} readings</span><span data-course-progress={course.id}>Choose where to begin</span></p>
        <div class="course-meter" data-meter={course.id} hidden><progress max={course.lessons.length} value="0" aria-label={`${course.title} reading progress`}></progress></div>
      </div>
      <div class="course-actions">
        <a class="course-open" href={course.href}>Explore course</a>
        <button type="button" data-download={course.id}>Save offline</button>
        <span class="download-state" data-download-state={course.id} aria-live="polite"></span>
      </div>
    </article>
  ))}
</div>
<p id="no-courses" hidden>No courses match. Try another subject or turn off the offline filter.</p>
<noscript><p>Enable JavaScript to save courses offline and track reading progress. Course links and PDFs work without it.</p></noscript>
